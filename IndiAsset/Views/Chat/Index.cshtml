@model IndiAsset.Models.ChatViewModel
@{
    ViewData["Title"] = "Messages & Chat";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .chat-app-container {
            height: calc(100vh - 140px);
            min-height: 600px;
            max-height: 850px;
            margin: 20px auto;
            background: #1a1d27;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(11, 43, 74, 0.08);
            border: 1px solid rgba(255,255,255,0.1);
            overflow: hidden;
            display: flex;
            position: relative;
        }

        /* ----- Left Sidebar ----- */
        .chat-sidebar {
            width: 360px;
            border-right: 1px solid rgba(255,255,255,0.06);
            display: flex;
            flex-direction: column;
            background: #1a1d27;
        }

        .chat-sidebar-header {
            padding: 20px 24px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .chat-sidebar-header h2 {
                font-size: 1.25rem;
                font-weight: 700;
                margin: 0;
                color: #f1f5f9;
            }

        .chat-search-box {
            padding: 12px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }

        .chat-search-input {
            width: 100%;
            padding: 9px 16px 9px 38px;
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 30px;
            font-size: 0.88rem;
            background: #1e2130;
            color: #f1f5f9;
            outline: none;
            transition: all 0.2s;
        }

        .chat-search-input::placeholder {
            color: #94a3b8;
        }

        .chat-search-input:focus {
            border-color: #2563eb;
            background: #1a1d27;
            color: #ffffff;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        .chat-search-wrap {
            position: relative;
        }

            .chat-search-wrap i {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: #94a3b8;
                font-size: 0.85rem;
            }

        .conversation-list {
            flex: 1;
            overflow-y: auto;
            padding: 8px 12px;
            margin: 0;
            list-style: none;
        }

        .conversation-item {
            display: flex;
            align-items: center;
            padding: 12px 14px;
            border-radius: 14px;
            cursor: pointer;
            text-decoration: none;
            color: inherit;
            margin-bottom: 6px;
            transition: all 0.2s;
            position: relative;
        }

            .conversation-item:hover {
                background: #252838;
            }

            .conversation-item.active {
                background: rgba(37, 99, 235, 0.18);
                border: 1px solid rgba(59, 130, 246, 0.35);
            }

        .user-avatar {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            background: linear-gradient(135deg, #2563eb, #60a5fa);
            color: white;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            flex-shrink: 0;
            margin-right: 14px;
            box-shadow: 0 3px 8px rgba(37, 99, 235, 0.2);
            position: relative;
        }

        .online-indicator {
            display: none !important;
        }

        .conversation-meta {
            flex: 1;
            min-width: 0;
        }

        .conversation-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 4px;
        }

        .conversation-name {
            font-weight: 600;
            font-size: 0.95rem;
            color: #f1f5f9;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .conversation-time {
            font-size: 0.75rem;
            color: #94a3b8;
        }

        .conversation-preview {
            font-size: 0.83rem;
            color: #94a3b8;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin: 0;
        }

        .unread-pill {
            background: #2563eb;
            color: white;
            border-radius: 20px;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 2px 7px;
            margin-left: 6px;
        }

        /* ----- Right Chat Area ----- */
        .chat-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: #1e2130;
        }

        .chat-main-header {
            padding: 16px 24px;
            background: #1a1d27;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .chat-header-user {
            display: flex;
            align-items: center;
        }

        .chat-header-info h3 {
            margin: 0;
            font-size: 1.05rem;
            font-weight: 700;
            color: #f1f5f9;
        }

        .chat-header-info span {
            font-size: 0.8rem;
            color: #94a3b8;
            font-weight: 500;
        }

            .chat-header-info span.online-text {
                color: #16a34a;
            }

        .chat-messages-container {
            flex: 1;
            overflow-y: auto;
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .message-bubble-wrapper {
            display: flex;
            align-items: flex-end;
            gap: 10px;
            max-width: 72%;
            animation: fadeInMsg 0.2s ease-in-out;
        }

        @@keyframes fadeInMsg {
            from {
                opacity: 0;
                transform: translateY(6px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .message-bubble-wrapper.sent {
            align-self: flex-end;
            flex-direction: row-reverse;
        }

        .message-bubble-wrapper.received {
            align-self: flex-start;
        }

        .message-avatar-small {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #475569, #94a3b8);
            color: white;
            font-size: 0.8rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .message-bubble {
            padding: 12px 18px;
            border-radius: 18px;
            font-size: 0.92rem;
            line-height: 1.45;
            position: relative;
            word-break: break-word;
        }

        .message-bubble-wrapper.sent .message-bubble {
            background: #2563eb;
            color: #ffffff;
            border-bottom-right-radius: 4px;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
        }

        .message-bubble-wrapper.received .message-bubble {
            background: #1a1d27;
            color: #e2e8f0;
            border-bottom-left-radius: 4px;
            border: 1px solid rgba(255,255,255,0.1);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        }

        .message-meta {
            font-size: 0.7rem;
            margin-top: 4px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .message-bubble-wrapper.sent .message-meta {
            color: rgba(255, 255, 255, 0.8);
            justify-content: flex-end;
        }

        .message-bubble-wrapper.received .message-meta {
            color: #94a3b8;
        }

        .chat-input-bar {
            padding: 16px 24px;
            background: #1a1d27;
            border-top: 1px solid rgba(255,255,255,0.06);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .chat-input-field {
            flex: 1;
            padding: 12px 20px;
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 30px;
            outline: none;
            font-size: 0.92rem;
            background: #1e2130;
            color: #f1f5f9;
            transition: all 0.2s;
        }

        .chat-input-field::placeholder {
            color: #94a3b8;
        }

        .chat-input-field:focus {
            border-color: #2563eb;
            background: #1a1d27;
            color: #ffffff;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        .btn-send-message {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: #2563eb;
            color: white;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
            box-shadow: 0 4px 10px rgba(37, 99, 235, 0.25);
            flex-shrink: 0;
        }

            .btn-send-message:hover {
                background: #1d4ed8;
                transform: scale(1.05);
            }

        .empty-chat-state {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 40px;
            color: #94a3b8;
        }

        .empty-chat-icon {
            width: 80px;
            height: 80px;
            background: rgba(37, 99, 235, 0.15);
            border: 1px solid rgba(59, 130, 246, 0.3);
            color: #60a5fa;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.2rem;
            margin-bottom: 20px;
        }

        .chat-toast {
            position: absolute;
            top: 20px;
            right: 20px;
            background: #1e2130;
            color: #ffffff;
            padding: 12px 20px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
            z-index: 1050;
            display: flex;
            align-items: center;
            gap: 12px;
            animation: slideInToast 0.3s ease;
        }

        @@keyframes slideInToast {
            from {
                transform: translateY(-20px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .connection-status-pill {
            font-size: 0.72rem;
            padding: 3px 8px;
            border-radius: 12px;
            font-weight: 600;
        }

            .connection-status-pill.connected {
                background: rgba(34, 197, 94, 0.2);
                color: #86efac;
                border: 1px solid rgba(34, 197, 94, 0.3);
            }

            .connection-status-pill.connecting {
                background: rgba(234, 179, 8, 0.2);
                color: #fde047;
                border: 1px solid rgba(234, 179, 8, 0.3);
            }

            .connection-status-pill.error {
                background: rgba(239, 68, 68, 0.2);
                color: #fca5a5;
                border: 1px solid rgba(239, 68, 68, 0.3);
            }

        @@media (max-width: 768px) {
            .chat-app-container {
                flex-direction: column;
                height: auto;
            }

            .chat-sidebar {
                width: 100%;
                height: 300px;
            }
        }
    </style>
}

<div class="container py-3 position-relative">
    <div id="toastContainer"></div>

    <div class="chat-app-container">

        <!-- =================== LEFT SIDEBAR =================== -->
        <div class="chat-sidebar">
            <div class="chat-sidebar-header">
                <div>
                    <h2>
                        <i class="fas fa-comments text-primary me-2"></i>Lease Chats
                    </h2>

                    <span id="connectionBadge"
                          class="connection-status-pill connecting">
                        <i class="fas fa-circle-notch fa-spin me-1"></i>Connecting...
                    </span>
                </div>
            </div>

            <div class="chat-search-box">
                <div class="chat-search-wrap">
                    <i class="fas fa-search"></i>
                    <input type="text"
                           id="chatSearchInput"
                           class="chat-search-input"
                           placeholder="Search conversations..." />
                </div>
            </div>

            <ul class="conversation-list" id="conversationList">
                @if (Model.Conversations.Any())
                {
                    @foreach (var conv in Model.Conversations)
                    {
                        var initial = !string.IsNullOrEmpty(conv.OtherUserName)
                            ? conv.OtherUserName.Substring(0, 1).ToUpper()
                            : "U";

                        <li id="conv-li-@conv.ConversationId">
                            <a asp-action="Index"
                               asp-route-conversationId="@conv.ConversationId"
                               class="conversation-item @(conv.IsSelected ? "active" : "")"
                               data-name="@conv.OtherUserName.ToLower()"
                               data-conv-id="@conv.ConversationId"
                               data-user-id="@conv.OtherUserId"
                               id="conv-link-@conv.ConversationId">

                                <div class="user-avatar">
                                    @initial
                                </div>

                                <div class="conversation-meta">
                                    <div class="conversation-header">
                                        <span class="conversation-name">
                                            @conv.OtherUserName
                                        </span>

                                        <span class="conversation-time"
                                              id="time-@conv.ConversationId">
                                            @(conv.LastMessageAt.HasValue
                                                ? conv.LastMessageAt.Value.ToLocalTime().ToString("hh:mm tt")
                                                : "")
                                        </span>
                                    </div>

                                    <div class="d-flex align-items-center justify-content-between">
                                        <p class="conversation-preview"
                                           id="preview-@conv.ConversationId">
                                            @conv.LastMessageContent
                                        </p>

                                        <span class="unread-pill @(conv.UnreadCount > 0 ? "" : "d-none")"
                                              id="unread-@conv.ConversationId">
                                            @(conv.UnreadCount > 0
                                                ? conv.UnreadCount.ToString()
                                                : "")
                                        </span>
                                    </div>
                                </div>
                            </a>
                        </li>
                    }
                }
                else
                {
                    <li class="p-4 text-center text-muted"
                        id="noConversationsPlaceholder">

                        <i class="fas fa-inbox fa-2x mb-2 text-secondary"></i>

                        <p class="small mb-2">
                            No conversations yet.
                        </p>
                    </li>
                }
            </ul>
        </div>

        <!-- =================== RIGHT CHAT MAIN =================== -->
        <div class="chat-main">

            @if (!string.IsNullOrEmpty(Model.ActiveConversationId) &&
                 Model.ActiveRecipient != null)
            {
                var recipientName =
                    !string.IsNullOrWhiteSpace(Model.ActiveRecipient.FullName)
                        ? Model.ActiveRecipient.FullName
                        : (Model.ActiveRecipient.UserName ?? "User");

                var recipientInitial =
                    recipientName.Substring(0, 1).ToUpper();

                <!-- Header -->
                <div class="chat-main-header">
                    <div class="chat-header-user">

                        <div class="user-avatar me-3">
                            @recipientInitial
                        </div>

                        <div class="chat-header-info">
                            <h3>@recipientName</h3>
                        </div>
                    </div>

                    <div>
                        <span class="badge bg-secondary bg-opacity-25 text-white border px-3 py-2">
                            <i class="fas fa-shield-alt text-primary me-1"></i>
                            Verified Lease Chat
                        </span>
                    </div>
                </div>

                <!-- Messages Stream -->
                <div class="chat-messages-container"
                     id="chatMessagesContainer">

                    @if (Model.Messages.Any())
                    {
                        @foreach (var msg in Model.Messages)
                        {
                            var initial =
                                !string.IsNullOrEmpty(msg.SenderName)
                                    ? msg.SenderName.Substring(0, 1).ToUpper()
                                    : "U";

                            <div class="message-bubble-wrapper @(msg.IsMine ? "sent" : "received")"
                                 data-msg-id="@msg.Id">

                                @if (!msg.IsMine)
                                {
                                    <div class="message-avatar-small">
                                        @initial
                                    </div>
                                }

                                <div>
                                    <div class="message-bubble">
                                        @msg.Content

                                        <div class="message-meta">
                                            <span>@msg.FormattedTime</span>

                                            @if (msg.IsMine)
                                            {
                                                <i class="fas fa-check-double ms-1"
                                                   style="font-size: 10px;"></i>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted my-auto"
                             id="noMessagesNotice">

                            <i class="far fa-paper-plane fa-2x mb-2 text-primary"></i>

                            <p class="mb-0">
                                This is the start of your lease conversation with
                                <strong>@recipientName</strong>.
                            </p>

                            <small>
                                Discuss terms, asset availability, delivery details,
                                and questions securely.
                            </small>
                        </div>
                    }
                </div>

                <!-- Input bar -->
                <form id="chatForm" class="chat-input-bar">

                    <input type="text"
                           id="messageInput"
                           class="chat-input-field"
                           placeholder="Type a message or inquiry..."
                           autocomplete="off" />

                    <button type="submit"
                            class="btn-send-message"
                            id="sendBtn"
                            title="Send Message">

                        <i class="fas fa-paper-plane"></i>
                    </button>
                </form>
            }
            else
            {
                <div class="empty-chat-state">

                    <div class="empty-chat-icon">
                        <i class="fas fa-comments"></i>
                    </div>

                    <h3 class="fw-bold text-white">
                        Welcome to IndiAsset Chat
                    </h3>

                    <p class="text-muted"
                       style="max-width: 420px;">

                        Connect directly with asset owners, lessors, and renters.
                        Inquire about equipment, rates, contracts, or logistics
                        in real-time.
                    </p>

                </div>
            }
        </div>
    </div>
</div>

@section Scripts {

    <!-- SignalR Client -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script>

        // Safely serialize server variables as JSON
        const activeConversationId =
        @Html.Raw(Json.Serialize(Model.ActiveConversationId ?? ""));

        const currentUserId =
        @Html.Raw(Json.Serialize(Model.CurrentUserId ?? ""));

        const recipientId =
        @Html.Raw(Json.Serialize(Model.ActiveRecipient?.Id ?? ""));

        const currentUserName =
        @Html.Raw(Json.Serialize(Model.CurrentUserName ?? "User"));

        const messagesContainer =
        document.getElementById("chatMessagesContainer");

        const messageInput =
        document.getElementById("messageInput");

        const chatForm =
        document.getElementById("chatForm");

        const connectionBadge =
        document.getElementById("connectionBadge");


        // ==========================================================
        // CONNECTION STATUS
        // ==========================================================

        function setConnectionStatus(status, text) {

        if (!connectionBadge) return;

        connectionBadge.className =
        `connection-status-pill ${status}`;

        if (status === 'connected') {

        connectionBadge.innerHTML =
        '<i class="fas fa-circle text-success me-1" style="font-size: 7px;"></i>Live';

        }
        else if (status === 'connecting') {

        connectionBadge.innerHTML =
        '<i class="fas fa-circle-notch fa-spin me-1"></i>Connecting...';

        }
        else {

        connectionBadge.innerHTML =
        '<i class="fas fa-exclamation-circle me-1"></i>' +
        (text || 'Disconnected');
        }
        }


        // ==========================================================
        // AUTO SCROLL
        // ==========================================================

        function scrollToBottom() {

        const container =
        document.getElementById("chatMessagesContainer");

        if (container) {
        container.scrollTop = container.scrollHeight;
        }
        }

        scrollToBottom();


        // ==========================================================
        // SEARCH CONVERSATIONS
        // ==========================================================

        const searchInput =
        document.getElementById("chatSearchInput");

        if (searchInput) {

        searchInput.addEventListener("input", function (e) {

        const query =
        e.target.value.toLowerCase().trim();

        const items =
        document.querySelectorAll(".conversation-item");

        items.forEach(item => {

        const name =
        item.getAttribute("data-name") || "";

        if (name.includes(query)) {

        item.parentElement.style.display = "";

        }
        else {

        item.parentElement.style.display = "none";
        }
        });
        });
        }


        // ==========================================================
        // SAFE HTML ESCAPING
        // ==========================================================

        function escapeHtml(text) {

        if (text === null || text === undefined)
        return "";

        return String(text).replace(
        /[&<>"']/g,
        function (m) {

        return {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
        }[m];
        }
        );
        }


        // ==========================================================
        // NORMALIZE MESSAGE
        // ==========================================================

        function normalizeMessage(msg) {

        if (!msg) return null;

        return {

        id:
        msg.id ||
        msg.Id ||
        ("temp_" + Date.now()),

        conversationId:
        msg.conversationId ||
        msg.ConversationId ||
        activeConversationId ||
        "",

        senderId:
        msg.senderId ||
        msg.SenderId ||
        currentUserId ||
        "",

        senderName:
        msg.senderName ||
        msg.SenderName ||
        currentUserName ||
        "User",

        receiverId:
        msg.receiverId ||
        msg.ReceiverId ||
        recipientId ||
        "",

        content:
        msg.content ||
        msg.Content ||
        "",

        sentAt:
        msg.sentAt ||
        msg.SentAt ||
        new Date().toISOString(),

        sentAtDisplay:
        msg.sentAtDisplay ||
        msg.SentAtDisplay ||
        msg.formattedTime ||
        msg.FormattedTime ||
        new Date().toLocaleTimeString(
        [],
        {
        hour: '2-digit',
        minute: '2-digit'
        }
        ),

        isRead:
        typeof msg.isRead !== 'undefined'
        ? msg.isRead
        : (
        typeof msg.IsRead !== 'undefined'
        ? msg.IsRead
        : false
        )
        };
        }


        // ==========================================================
        // SIGNALR CONNECTION
        // ==========================================================

        const connection =
        new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .withAutomaticReconnect(
        [0, 1000, 3000, 5000, 10000]
        )
        .build();


        // ==========================================================
        // USER STATUS CHANGES
        // ==========================================================

        connection.on(
        "UserStatusChanged",
        function (userId, isOnline, lastSeen) {
            // Status and last seen indicators removed per user request
        }
        );


        // ==========================================================
        // RENDER MESSAGE
        // ==========================================================

        function renderMessage(rawMsg) {

        const msg =
        normalizeMessage(rawMsg);

        if (!msg || !msg.content)
        return;


        const container =
        document.getElementById(
        "chatMessagesContainer"
        );

        if (!container)
        return;


        // Avoid duplicate rendering
        if (
        msg.id &&
        document.querySelector(
        `[data-msg-id="${msg.id}"]`
        )
        ) {
        return;
        }


        const noNotice =
        document.getElementById(
        "noMessagesNotice"
        );

        if (noNotice)
        noNotice.remove();


        const isMine =
        (
        msg.senderId &&
        currentUserId &&
        String(msg.senderId).toLowerCase() ===
        String(currentUserId).toLowerCase()
        );


        const initial =
        msg.senderName
        ? msg.senderName.charAt(0).toUpperCase()
        : "U";


        const wrapper =
        document.createElement("div");

        wrapper.className =
        `message-bubble-wrapper ${isMine ? 'sent' : 'received'}`;


        if (msg.id)
        wrapper.setAttribute(
        "data-msg-id",
        msg.id
        );


        let avatarHtml = "";

        if (!isMine) {

        avatarHtml =
        `<div class="message-avatar-small">${initial}</div>`;
        }


        const checkIcon =
        isMine
        ? `<i class="fas fa-check-double ms-1" style="font-size: 10px;"></i>`
        : "";


        wrapper.innerHTML = `
        ${avatarHtml}

        <div>
        <div class="message-bubble">

        ${escapeHtml(msg.content)}

        <div class="message-meta">

        <span>
        ${escapeHtml(msg.sentAtDisplay)}
        </span>

        ${checkIcon}

        </div>

        </div>
        </div>
        `;


        container.appendChild(wrapper);

        scrollToBottom();
        }


        // ==========================================================
        // UPDATE SIDEBAR
        // ==========================================================

        function updateSidebarItem(rawMsg) {

        const msg =
        normalizeMessage(rawMsg);

        if (!msg || !msg.conversationId)
        return;


        const list =
        document.getElementById(
        "conversationList"
        );


        const placeholder =
        document.getElementById(
        "noConversationsPlaceholder"
        );


        if (placeholder)
        placeholder.remove();


        const convId =
        msg.conversationId;


        let listItem =
        document.getElementById(
        `conv-li-${convId}`
        );


        if (listItem) {

        const preview =
        document.getElementById(
        `preview-${convId}`
        );

        const time =
        document.getElementById(
        `time-${convId}`
        );


        if (preview)
        preview.textContent =
        msg.content;


        if (time && msg.sentAtDisplay)
        time.textContent =
        msg.sentAtDisplay;


        const isCurrent =
        activeConversationId &&
        String(convId).toLowerCase() ===
        String(activeConversationId).toLowerCase();


        const isMine =
        msg.senderId &&
        currentUserId &&
        String(msg.senderId).toLowerCase() ===
        String(currentUserId).toLowerCase();


        if (!isCurrent && !isMine) {

        let unreadBadge =
        document.getElementById(
        `unread-${convId}`
        );


        if (unreadBadge) {

        let currentCount =
        parseInt(
        unreadBadge.textContent || "0"
        );

        unreadBadge.textContent =
        currentCount + 1;

        unreadBadge.classList.remove(
        "d-none"
        );
        }
        }


        if (list) {

        list.insertBefore(
        listItem,
        list.firstChild
        );
        }

        }
        else if (list) {

        const senderName =
        msg.senderName || "User";

        const initial =
        senderName.charAt(0).toUpperCase();


        const newLi =
        document.createElement("li");


        newLi.id =
        `conv-li-${convId}`;


        newLi.innerHTML = `
        <a href="/Chat?conversationId=${convId}"
        class="conversation-item"
        data-name="${escapeHtml(senderName.toLowerCase())}"
        data-conv-id="${convId}"
        id="conv-link-${convId}">

        <div class="user-avatar">

        ${initial}

        </div>

        <div class="conversation-meta">

        <div class="conversation-header">

        <span class="conversation-name">
        ${escapeHtml(senderName)}
        </span>

        <span class="conversation-time"
        id="time-${convId}">
        ${escapeHtml(msg.sentAtDisplay)}
        </span>

        </div>

        <div class="d-flex align-items-center justify-content-between">

        <p class="conversation-preview"
        id="preview-${convId}">
        ${escapeHtml(msg.content)}
        </p>

        <span class="unread-pill"
        id="unread-${convId}">
        1
        </span>

        </div>

        </div>

        </a>
        `;


        list.insertBefore(
        newLi,
        list.firstChild
        );
        }
        }


        // ==========================================================
        // NOTIFICATION TOAST
        // ==========================================================

        function showNotificationToast(msg) {

        const container =
        document.getElementById(
        "toastContainer"
        );

        if (!container)
        return;


        const toast =
        document.createElement("div");

        toast.className =
        "chat-toast";


        toast.innerHTML = `
        <i class="fas fa-comment-dots text-primary fa-lg"></i>

        <div>

        <strong>
        ${escapeHtml(
        msg.senderName ||
        "New Message"
        )}
        </strong>

        <div class="small text-light"
        style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">

        ${escapeHtml(msg.content)}

        </div>

        </div>

        <a href="/Chat?conversationId=${msg.conversationId}"
        class="btn btn-sm btn-primary ms-2"
        style="font-size: 0.75rem; border-radius: 20px;">

        View

        </a>
        `;


        container.appendChild(toast);


        setTimeout(() => {

        toast.style.transition =
        "opacity 0.5s ease";

        toast.style.opacity = "0";


        setTimeout(
        () => toast.remove(),
        500
        );

        }, 4500);
        }


        // ==========================================================
        // RECEIVE MESSAGE VIA SIGNALR
        // ==========================================================

        connection.on(
        "ReceiveMessage",
        function (rawMsg) {

        console.log(
        "ReceiveMessage event received:",
        rawMsg
        );


        const msg =
        normalizeMessage(rawMsg);

        if (!msg)
        return;


        const isCurrentConversation =
        activeConversationId &&
        String(msg.conversationId).toLowerCase() ===
        String(activeConversationId).toLowerCase();


        if (isCurrentConversation) {

        renderMessage(msg);


        if (msg.senderId !== currentUserId) {

        connection.invoke(
        "MarkAsRead",
        msg.id,
        msg.conversationId
        )
        .catch(console.error);
        }

        }
        else if (msg.senderId !== currentUserId) {

        showNotificationToast(msg);
        }


        updateSidebarItem(msg);
        }
        );


        // ==========================================================
        // START SIGNALR
        // ==========================================================

        function startSignalR() {

        setConnectionStatus(
        'connecting'
        );


        connection.start()
        .then(function () {

        console.log(
        "Connected to ChatHub successfully"
        );


        setConnectionStatus(
        'connected'
        );


        if (activeConversationId) {

        connection.invoke(
        "JoinConversation",
        activeConversationId
        )
        .catch(console.error);
        }


        // Query initial online status (noop - presence indicator disabled)
        connection.invoke(
        "GetOnlineUsers"
        )
        .catch(console.error);

        })
        .catch(function (err) {

        console.error(
        "SignalR Connection Error: ",
        err.toString()
        );


        setConnectionStatus(
        'error',
        'Disconnected'
        );
        });
        }


        // ==========================================================
        // SIGNALR RECONNECTING
        // ==========================================================

        connection.onreconnecting(
        function (err) {

        console.warn(
        "SignalR Reconnecting: ",
        err
        );

        setConnectionStatus(
        'connecting'
        );
        }
        );


        // ==========================================================
        // SIGNALR RECONNECTED
        // ==========================================================

        connection.onreconnected(
        function (connectionId) {

        console.log(
        "Reconnected to ChatHub: " +
        connectionId
        );


        setConnectionStatus(
        'connected'
        );


        if (activeConversationId) {

        connection.invoke(
        "JoinConversation",
        activeConversationId
        )
        .catch(console.error);
        }


        connection.invoke(
        "GetOnlineUsers"
        )
        .then(function (onlineUserIds) {

        if (
        onlineUserIds &&
        Array.isArray(onlineUserIds)
        ) {

        onlineUserIds.forEach(
        uid => {

        const userDot =
        document.getElementById(
        `user-status-dot-${uid}`
        );


        if (userDot) {

        userDot.className =
        "online-indicator online";
        }
        }
        );
        }

        })
        .catch(console.error);
        }
        );


        // ==========================================================
        // SIGNALR CLOSED
        // ==========================================================

        connection.onclose(
        function (err) {

        console.warn(
        "SignalR Connection Closed: ",
        err
        );


        setConnectionStatus(
        'error',
        'Disconnected'
        );
        }
        );


        startSignalR();


        // ==========================================================
        // SEND MESSAGE
        // ==========================================================

        if (chatForm && messageInput) {

        chatForm.addEventListener(
        "submit",
        function (e) {

        e.preventDefault();


        const content =
        messageInput.value.trim();


        if (
        !content ||
        !activeConversationId
        ) {
        return;
        }


        messageInput.value = "";

        messageInput.focus();


        connection.invoke(
        "SendMessage",
        activeConversationId,
        recipientId || "",
        content
        )
        .then(function (rawPayload) {

        console.log(
        "SendMessage response:",
        rawPayload
        );


        const payload =
        normalizeMessage(
        rawPayload
        );


        if (payload) {

        renderMessage(
        payload
        );

        updateSidebarItem(
        payload
        );
        }
        })
        .catch(function (err) {

        console.error(
        "Error sending message: ",
        err.toString()
        );


        alert(
        "Could not send message. Please check connection: " +
        err.toString()
        );
        });
        }
        );
        }


        // ==========================================================
        // CROSS-DEVICE REAL-TIME AUTO-SYNC
        // MONGODB ATLAS CLOUD SYNC
        // ==========================================================

        let lastSyncTime =
        new Date(
        Date.now() - 15000
        ).toISOString();


        let isSyncing = false;


        async function syncLatestMessages() {

        if (
        !activeConversationId ||
        isSyncing
        ) {
        return;
        }


        isSyncing = true;


        try {

        const url =
        `/Chat/GetMessages?conversationId=${encodeURIComponent(activeConversationId)}&after=${encodeURIComponent(lastSyncTime)}`;


        const response =
        await fetch(
        url,
        {
        headers: {
        'X-Requested-With':
        'XMLHttpRequest'
        }
        }
        );


        if (response.ok) {

        const messages =
        await response.json();


        if (
        Array.isArray(messages) &&
        messages.length > 0
        ) {

        messages.forEach(
        rawMsg => {

        const msg =
        normalizeMessage(
        rawMsg
        );


        if (msg) {

        renderMessage(
        msg
        );


        updateSidebarItem(
        msg
        );


        if (
        msg.sentAt &&
        msg.sentAt >
        lastSyncTime
        ) {

        lastSyncTime =
        msg.sentAt;
        }
        }
        }
        );
        }
        }

        }
        catch (err) {

        // Silently wait for next interval
        }
        finally {

        isSyncing = false;
        }
        }


        // Poll MongoDB Atlas every 2 seconds
        // for cross-device updates
        setInterval(
        syncLatestMessages,
        2000
        );

    </script>
}