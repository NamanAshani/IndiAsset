@model IndiAsset.Models.DispatchCheckInViewModel
@{
    ViewData["Title"] = "Dispatch Handover Check-In — IndiAsset";
}

@section Styles {
    <style>
        .upload-dropzone {
            border: 2px dashed rgba(96, 165, 250, 0.4);
            background: rgba(37, 99, 235, 0.04);
            border-radius: 18px;
            padding: 36px 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .upload-dropzone:hover {
            border-color: #3b82f6;
            background: rgba(37, 99, 235, 0.09);
        }

        .preview-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
            gap: 12px;
            margin-top: 16px;
        }

        .preview-item {
            position: relative;
            border-radius: 12px;
            overflow: hidden;
            aspect-ratio: 4/3;
            background: #1e2130;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .preview-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .info-pill {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 12px 16px;
        }
    </style>
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
                <div>
                    <a asp-action="MyBookings" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 mb-2">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Leases
                    </a>
                    <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
                        <span>📦 Dispatch Handover Check-In</span>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 rounded-pill px-3">Pre-Lease Baseline</span>
                    </h2>
                    <p class="text-secondary mb-0">Record fresh handover photos of the equipment at handover to establish the certified baseline condition.</p>
                </div>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- EQUIPMENT & LEASE SUMMARY CARD -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" style="background: #181b28; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                <div class="card-body p-4">
                    <div class="row align-items-center g-4">
                        <div class="col-md-3 text-center">
                            @if (!string.IsNullOrEmpty(Model.PrimaryImageUrl))
                            {
                                <img src="@Model.PrimaryImageUrl" class="rounded-3 shadow-sm img-fluid object-fit-cover" style="max-height: 140px; width: 100%;" alt="@Model.AssetTitle" />
                            }
                            else
                            {
                                <div class="rounded-3 d-flex align-items-center justify-content-center bg-dark" style="height: 130px;">
                                    <i class="fa-solid fa-cube fa-3x text-secondary"></i>
                                </div>
                            }
                        </div>
                        <div class="col-md-9">
                            <div class="badge bg-info-subtle text-info rounded-pill px-3 py-1 mb-2">@Model.AssetCategory</div>
                            <h4 class="fw-bold mb-2">@Model.AssetTitle</h4>
                            
                            <div class="row g-2 mt-2">
                                <div class="col-sm-4">
                                    <div class="info-pill">
                                        <div class="text-secondary small">Renter / Lessee</div>
                                        <div class="fw-semibold">@Model.RenterName</div>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="info-pill">
                                        <div class="text-secondary small">Lease Period</div>
                                        <div class="fw-semibold">@Model.StartDate.ToString("dd MMM") - @Model.EndDate.ToString("dd MMM yyyy") (@Model.TotalDays d)</div>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="info-pill">
                                        <div class="text-secondary small">Escrow Security Deposit</div>
                                        <div class="fw-semibold text-warning">₹@Model.SecurityDeposit.ToString("N0")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- EXPLANATION BANNER -->
            <div class="alert alert-info border-0 rounded-4 p-3 mb-4 d-flex align-items-start gap-3" style="background: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.25) !important;">
                <i class="fa-solid fa-camera fa-lg text-primary mt-1"></i>
                <div class="small">
                    <strong class="text-primary d-block mb-1">Why take Dispatch Handover Photos?</strong>
                    In industrial equipment leasing, condition comparison should always compare against the <strong>exact handover condition</strong> when equipment left dispatch, rather than years-old catalog photos. The photos uploaded here become the certified baseline for the post-lease return inspection.
                </div>
            </div>

            <!-- UPLOAD FORM -->
            <form asp-action="DispatchCheckIn" method="post" enctype="multipart/form-data" id="dispatchForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BookingId" />
                <input type="hidden" asp-for="AssetId" />
                <input type="hidden" asp-for="AssetTitle" />
                <input type="hidden" asp-for="AssetCategory" />
                <input type="hidden" asp-for="PrimaryImageUrl" />
                <input type="hidden" asp-for="RenterName" />

                <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: #181b28; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                            <i class="fa-solid fa-images text-primary"></i> Handover Condition Photos
                        </h5>

                        <div class="upload-dropzone" id="dropzone" onclick="document.getElementById('photoInput').click()">
                            <input type="file" id="photoInput" name="DispatchPhotos" multiple accept="image/*" class="d-none" onchange="handleFileSelect(this)" />
                            <i class="fa-solid fa-cloud-arrow-up fa-3x text-primary mb-3"></i>
                            <h5 class="fw-bold mb-1">Click to Upload or Drag & Drop Photos</h5>
                            <p class="text-secondary small mb-0">Take high-resolution photos of all angles (front, sides, controls, meter reading, operational surface). JPG, PNG, WEBP supported.</p>
                        </div>
                        <span asp-validation-for="DispatchPhotos" class="text-danger small mt-2 d-block"></span>

                        <!-- PREVIEW CONTAINER -->
                        <div class="preview-grid" id="previewGrid"></div>

                        <!-- NOTES -->
                        <div class="mt-4">
                            <label asp-for="DispatchNotes" class="form-label fw-semibold">Handover Notes & Remarks (Optional)</label>
                            <textarea asp-for="DispatchNotes" rows="3" class="form-control rounded-3" style="background: #12141f; border-color: rgba(255,255,255,0.1); color: #fff;" placeholder="Note initial meter reading, accessories included, or pre-existing minor surface wear..."></textarea>
                            <span asp-validation-for="DispatchNotes" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between gap-3">
                    <a asp-action="MyBookings" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-semibold" id="submitBtn">
                        <i class="fa-solid fa-check me-2"></i> Complete Dispatch Check-In
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const dropzone = document.getElementById('dropzone');
        const photoInput = document.getElementById('photoInput');
        const previewGrid = document.getElementById('previewGrid');

        ['dragenter', 'dragover'].forEach(eventName => {
            dropzone.addEventListener(eventName, (e) => {
                e.preventDefault();
                dropzone.style.borderColor = '#3b82f6';
                dropzone.style.background = 'rgba(37, 99, 235, 0.12)';
            });
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropzone.addEventListener(eventName, (e) => {
                e.preventDefault();
                dropzone.style.borderColor = 'rgba(96, 165, 250, 0.4)';
                dropzone.style.background = 'rgba(37, 99, 235, 0.04)';
            });
        });

        dropzone.addEventListener('drop', (e) => {
            if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                photoInput.files = e.dataTransfer.files;
                handleFileSelect(photoInput);
            }
        });

        function handleFileSelect(input) {
            previewGrid.innerHTML = '';
            if (input.files && input.files.length > 0) {
                Array.from(input.files).forEach((file, idx) => {
                    if (file.type.startsWith('image/')) {
                        const reader = new FileReader();
                        reader.onload = (e) => {
                            const div = document.createElement('div');
                            div.className = 'preview-item shadow-sm';
                            div.innerHTML = `<img src="${e.target.result}" alt="Preview ${idx + 1}" />`;
                            previewGrid.appendChild(div);
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }
        }

        document.getElementById('dispatchForm').addEventListener('submit', function() {
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Recording Dispatch Baseline...';
        });
    </script>
}
