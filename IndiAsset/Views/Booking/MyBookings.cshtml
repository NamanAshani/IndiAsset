@model IndiAsset.Models.MyBookingsViewModel
@using IndiAsset.Models
@{
    ViewData["Title"] = "My Leases & Bookings — IndiAsset";

    bool isOwnerTab = string.Equals(Model.ActiveTab, "owner", StringComparison.OrdinalIgnoreCase);

    string renterTabClass  = isOwnerTab ? "nav-link d-flex align-items-center justify-content-center gap-2"
                                        : "nav-link active d-flex align-items-center justify-content-center gap-2";
    string ownerTabClass   = isOwnerTab ? "nav-link active d-flex align-items-center justify-content-center gap-2"
                                        : "nav-link d-flex align-items-center justify-content-center gap-2";
    string renterPaneClass = isOwnerTab ? "tab-pane fade" : "tab-pane fade show active";
    string ownerPaneClass  = isOwnerTab ? "tab-pane fade show active" : "tab-pane fade";
}

@section Styles {
    <style>
        .booking-card {
            background: #1a1d27;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            transition: all 0.25s;
        }
        .booking-card:hover {
            border-color: rgba(96, 165, 250, 0.35);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            transform: translateY(-2px);
        }
        .booking-info-box {
            background: #1e2130;
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 14px;
            padding: 14px 16px;
        }
        .nav-pills-dark {
            background: #1a1d27;
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 6px;
            border-radius: 50px;
        }
        .nav-pills-dark .nav-link {
            border-radius: 40px;
            color: #94a3b8;
            font-weight: 600;
            padding: 10px 20px;
            transition: all 0.2s;
        }
        .nav-pills-dark .nav-link.active {
            background: #2563eb;
            color: #ffffff;
            box-shadow: 0 4px 15px rgba(37, 99, 235, 0.35);
        }
        .nav-pills-dark .nav-link:hover:not(.active) {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.05);
        }
    </style>
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold text-white mb-1">Lease Agreements &amp; Bookings</h1>
            <p class="text-muted mb-0">Track assets you are taking on lease, and manage lease inquiries on your listed equipment.</p>
        </div>
        <a asp-controller="Asset" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold">
            <i class="fa-solid fa-magnifying-glass me-1"></i> Browse Marketplace
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <ul class="nav nav-pills nav-pills-dark nav-fill mb-4" id="bookingTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="@renterTabClass" id="renter-tab" data-bs-toggle="tab" data-bs-target="#renter-content" type="button" role="tab">
                <i class="fa-solid fa-handshake-simple"></i>
                <span>Assets I am Leasing (Renter)</span>
                <span class="badge bg-primary text-white rounded-pill px-2">@Model.AsRenterBookings.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="@ownerTabClass" id="owner-tab" data-bs-toggle="tab" data-bs-target="#owner-content" type="button" role="tab">
                <i class="fa-solid fa-building-circle-check"></i>
                <span>Lease Inquiries for My Assets (Owner)</span>
                <span class="badge bg-warning text-dark rounded-pill px-2">@Model.AsOwnerBookings.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content" id="bookingTabsContent">

        <!-- TAB 1: AS RENTER -->
        <div class="@renterPaneClass" id="renter-content" role="tabpanel">
            @if (Model.AsRenterBookings.Any())
            {
                <div class="row g-4">
                    @foreach (var item in Model.AsRenterBookings)
                    {
                        <div class="col-lg-6">
                            <div class="booking-card h-100 overflow-hidden">
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <span class="badge bg-secondary bg-opacity-25 text-white border border-secondary border-opacity-25 rounded-pill px-3 py-1">@item.Category</span>
                                        @switch (item.Status)
                                        {
                                            case BookingStatus.Pending:
                                                <span class="badge bg-warning text-dark rounded-pill px-3 py-1 fw-semibold"><i class="fa-solid fa-hourglass-half me-1"></i> Awaiting Approval</span>
                                                break;
                                            case BookingStatus.Approved:
                                                <span class="badge bg-info text-dark rounded-pill px-3 py-1 fw-semibold"><i class="fa-solid fa-check me-1"></i> Approved</span>
                                                break;
                                            case BookingStatus.Active:
                                                <span class="badge bg-success rounded-pill px-3 py-1"><i class="fa-solid fa-circle-play me-1"></i> Active On Lease</span>
                                                break;
                                            case BookingStatus.Completed:
                                                <span class="badge bg-secondary rounded-pill px-3 py-1"><i class="fa-solid fa-circle-check me-1"></i> Returned &amp; Closed</span>
                                                break;
                                            case BookingStatus.Rejected:
                                                <span class="badge bg-danger rounded-pill px-3 py-1"><i class="fa-solid fa-ban me-1"></i> Declined</span>
                                                break;
                                            case BookingStatus.Cancelled:
                                                <span class="badge bg-secondary bg-opacity-25 text-muted rounded-pill px-3 py-1">Cancelled</span>
                                                break;
                                        }
                                    </div>
                                    <div class="d-flex gap-3 mb-3">
                                        <div class="rounded-3 overflow-hidden bg-dark flex-shrink-0 border border-secondary border-opacity-25" style="width:80px;height:80px;">
                                            @if (!string.IsNullOrEmpty(item.AssetImageUrl))
                                            {
                                                <img src="@item.AssetImageUrl" class="w-100 h-100 object-fit-cover" alt="@item.AssetTitle" />
                                            }
                                            else
                                            {
                                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                                    <i class="fa-solid fa-cube fa-2x"></i>
                                                </div>
                                            }
                                        </div>
                                        <div>
                                            <h5 class="fw-bold text-white mb-1">@item.AssetTitle</h5>
                                            <p class="small text-muted mb-0">Owner: <strong class="text-white">@item.OtherUserName</strong></p>
                                        </div>
                                    </div>
                                    <div class="booking-info-box mb-3 small">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted"><i class="fa-regular fa-calendar me-1"></i> Duration:</span>
                                            <span class="fw-semibold text-white">@item.StartDate.ToString("dd MMM yyyy") - @item.EndDate.ToString("dd MMM yyyy") (@item.TotalDays days)</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted">Total Rent:</span>
                                            <span class="text-white">₹@item.TotalRent.ToString("N0")</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted">Escrow Security Deposit:</span>
                                            @if (item.SecurityDeposit > 0)
                                            {
                                                @if (item.IsSecurityDepositPaid)
                                                {
                                                    <span class="text-success fw-semibold"><i class="fa-solid fa-shield-check me-1"></i>₹@item.SecurityDeposit.ToString("N0") (Paid in Escrow)</span>
                                                }
                                                else
                                                {
                                                    <span class="text-warning fw-semibold"><i class="fa-solid fa-clock me-1"></i>₹@item.SecurityDeposit.ToString("N0") (Payment Required)</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">₹0</span>
                                            }
                                        </div>
                                        <div class="d-flex justify-content-between border-top border-secondary border-opacity-25 pt-2 mt-2 fw-bold text-white">
                                            <span>Est. Settlement on Return:</span>
                                            <span class="text-primary">₹@Math.Max(0, item.TotalRent - (item.IsSecurityDepositPaid ? item.SecurityDeposit : 0)).ToString("N0")</span>
                                        </div>
                                    </div>
                                    @if (item.Status == BookingStatus.Pending && !item.IsSecurityDepositPaid && item.SecurityDeposit > 0)
                                    {
                                        <div class="alert alert-warning py-2 px-3 small rounded-3 mb-3 d-flex align-items-center justify-content-between gap-2 border border-warning border-opacity-25" style="background: rgba(245, 158, 11, 0.12);">
                                            <div>
                                                <i class="fa-solid fa-shield-halved text-warning me-1"></i>
                                                <strong class="text-warning">Deposit Required:</strong>
                                                <span class="text-white-50">Pay deposit into escrow to enable owner approval.</span>
                                            </div>
                                            <a asp-controller="Booking" asp-action="PayDeposit" asp-route-id="@item.BookingId" class="btn btn-warning btn-sm rounded-pill px-3 py-1 fw-bold text-dark flex-shrink-0 shadow-sm">
                                                Pay ₹@item.SecurityDeposit.ToString("N0")
                                            </a>
                                        </div>
                                    }
                                    <div class="mt-auto d-flex flex-wrap gap-2">
                                        @if (item.Status == BookingStatus.Pending && !item.IsSecurityDepositPaid && item.SecurityDeposit > 0)
                                        {
                                            <a asp-controller="Booking" asp-action="PayDeposit" asp-route-id="@item.BookingId" class="btn btn-warning btn-sm rounded-pill px-3 py-2 fw-bold text-dark shadow-sm">
                                                <i class="fa-solid fa-shield-halved me-1"></i> Pay Security Deposit (₹@item.SecurityDeposit.ToString("N0"))
                                            </a>
                                        }
                                        <a asp-controller="Chat" asp-action="Index" asp-route-recipientId="@item.OtherUserId" class="btn btn-outline-primary btn-sm rounded-pill py-2 px-3 fw-semibold">
                                            <i class="fa-regular fa-comments me-1"></i> Chat
                                        </a>
                                        <a asp-controller="Asset" asp-action="Details" asp-route-id="@item.AssetId" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2 text-white">
                                            View Asset
                                        </a>
                                        @if (item.Status == BookingStatus.Active || item.Status == BookingStatus.Approved)
                                        {
                                            <a asp-controller="Booking" asp-action="ReturnAsset" asp-route-bookingId="@item.BookingId" class="btn btn-warning btn-sm rounded-pill px-3 py-2 fw-semibold text-dark">
                                                <i class="fa-solid fa-credit-card me-1"></i> Pay &amp; Return Asset
                                            </a>
                                        }
                                        @if (item.Status == BookingStatus.Completed || item.HasReturnInspection)
                                        {
                                            <a asp-controller="Booking" asp-action="InspectionReview" asp-route-bookingId="@item.BookingId" class="btn btn-info btn-sm rounded-pill px-3 py-2 fw-semibold text-dark">
                                                <i class="fa-solid fa-clipboard-check me-1"></i> View Condition &amp; Review
                                            </a>
                                        }
                                        @if (item.Status == BookingStatus.Pending)
                                        {
                                            <form method="post" asp-action="Cancel" asp-route-id="@item.BookingId" class="d-inline" onsubmit="return confirm('Cancel this lease request?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2">Cancel</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 booking-card">
                    <i class="fa-solid fa-file-contract fa-3x text-muted opacity-50 mb-3"></i>
                    <h4 class="fw-bold text-white">No active leases yet</h4>
                    <p class="text-muted mb-4">You have not requested any assets on lease yet.</p>
                    <a asp-controller="Asset" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                        <i class="fa-solid fa-magnifying-glass me-1"></i> Explore Assets to Lease
                    </a>
                </div>
            }
        </div>

        <!-- TAB 2: AS ASSET OWNER -->
        <div class="@ownerPaneClass" id="owner-content" role="tabpanel">
            @if (Model.AsOwnerBookings.Any())
            {
                <div class="row g-4">
                    @foreach (var item in Model.AsOwnerBookings)
                    {
                        <div class="col-lg-6">
                            <div class="booking-card h-100 overflow-hidden">
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <span class="badge bg-secondary bg-opacity-25 text-white border border-secondary border-opacity-25 rounded-pill px-3 py-1">@item.Category</span>
                                        @switch (item.Status)
                                        {
                                            case BookingStatus.Pending:
                                                <span class="badge bg-warning text-dark rounded-pill px-3 py-1 fw-semibold"><i class="fa-solid fa-bell me-1"></i> Action Needed: Request Received</span>
                                                break;
                                            case BookingStatus.Approved:
                                                <span class="badge bg-info text-dark rounded-pill px-3 py-1 fw-semibold"><i class="fa-solid fa-check me-1"></i> Approved</span>
                                                break;
                                            case BookingStatus.Active:
                                                <span class="badge bg-success rounded-pill px-3 py-1"><i class="fa-solid fa-circle-play me-1"></i> Occupied / Active</span>
                                                break;
                                            case BookingStatus.Completed:
                                                <span class="badge bg-secondary rounded-pill px-3 py-1"><i class="fa-solid fa-circle-check me-1"></i> Completed &amp; Returned</span>
                                                break;
                                            case BookingStatus.Rejected:
                                                <span class="badge bg-danger rounded-pill px-3 py-1">Declined</span>
                                                break;
                                            case BookingStatus.Cancelled:
                                                <span class="badge bg-secondary bg-opacity-25 text-muted rounded-pill px-3 py-1">Cancelled by Renter</span>
                                                break;
                                        }
                                    </div>
                                    <div class="d-flex gap-3 mb-3">
                                        <div class="rounded-3 overflow-hidden bg-dark flex-shrink-0 border border-secondary border-opacity-25" style="width:80px;height:80px;">
                                            @if (!string.IsNullOrEmpty(item.AssetImageUrl))
                                            {
                                                <img src="@item.AssetImageUrl" class="w-100 h-100 object-fit-cover" alt="@item.AssetTitle" />
                                            }
                                            else
                                            {
                                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                                    <i class="fa-solid fa-cube fa-2x"></i>
                                                </div>
                                            }
                                        </div>
                                        <div>
                                            <h5 class="fw-bold text-white mb-1">@item.AssetTitle</h5>
                                            <p class="small text-muted mb-0">Requested by: <strong class="text-white">@item.OtherUserName</strong></p>
                                        </div>
                                    </div>
                                    <div class="booking-info-box mb-3 small">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted"><i class="fa-regular fa-calendar me-1"></i> Schedule:</span>
                                            <span class="fw-semibold text-white">@item.StartDate.ToString("dd MMM yyyy") - @item.EndDate.ToString("dd MMM yyyy") (@item.TotalDays days)</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted">Earnings (Rent):</span>
                                            <span class="fw-semibold text-success">₹@item.TotalRent.ToString("N0")</span>
                                        </div>
                                        <div class="d-flex justify-content-between border-top border-secondary border-opacity-25 pt-2 mt-2">
                                            <span class="text-muted">Escrow Deposit:</span>
                                            @if (item.SecurityDeposit > 0)
                                            {
                                                if (item.IsSecurityDepositPaid)
                                                {
                                                    <span class="text-success fw-semibold"><i class="fa-solid fa-shield-check me-1"></i>₹@item.SecurityDeposit.ToString("N0") (Secured in Escrow)</span>
                                                }
                                                else
                                                {
                                                    <span class="text-warning fw-semibold"><i class="fa-solid fa-clock me-1"></i>₹@item.SecurityDeposit.ToString("N0") (Unpaid by Renter)</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">₹0</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="mt-auto d-flex flex-wrap gap-2">
                                        <a asp-controller="Chat" asp-action="Index" asp-route-recipientId="@item.OtherUserId" class="btn btn-outline-primary btn-sm rounded-pill py-2 px-3 fw-semibold">
                                            <i class="fa-regular fa-comments me-1"></i> Chat with Renter
                                        </a>
                                        @if (item.Status == BookingStatus.Completed || item.HasReturnInspection)
                                        {
                                            <a asp-controller="Booking" asp-action="InspectionReview" asp-route-bookingId="@item.BookingId" class="btn btn-info btn-sm rounded-pill px-3 py-2 fw-semibold text-dark">
                                                <i class="fa-solid fa-clipboard-check me-1"></i> Inspect Condition &amp; Review
                                            </a>
                                        }
                                        @if (item.Status == BookingStatus.Pending)
                                        {
                                            @if (item.IsSecurityDepositPaid || item.SecurityDeposit <= 0)
                                            {
                                                <form method="post" asp-action="Approve" asp-route-id="@item.BookingId" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-success btn-sm rounded-pill px-3 py-2 fw-semibold">
                                                        <i class="fa-solid fa-check me-1"></i> Accept Request
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <button class="btn btn-secondary btn-sm rounded-pill px-3 py-2 fw-semibold" disabled title="Renter must pay the escrow deposit first">
                                                    <i class="fa-solid fa-lock me-1"></i> Awaiting Renter Deposit
                                                </button>
                                            }
                                            <form method="post" asp-action="Reject" asp-route-id="@item.BookingId" class="d-inline" onsubmit="return confirm('Decline this lease inquiry?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2">Decline</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 booking-card">
                    <i class="fa-solid fa-inbox fa-3x text-muted opacity-50 mb-3"></i>
                    <h4 class="fw-bold text-white">No lease inquiries yet</h4>
                    <p class="text-muted mb-4">When contractors and businesses request to lease your equipment, they will appear right here.</p>
                    <a asp-controller="Asset" asp-action="MyAssets" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                        <i class="fa-solid fa-gear me-1"></i> Manage Your Assets
                    </a>
                </div>
            }
        </div>

    </div>
</div>
