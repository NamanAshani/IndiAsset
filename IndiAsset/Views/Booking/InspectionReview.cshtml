@model IndiAsset.Models.InspectionReviewViewModel
@{
    ViewData["Title"] = "Asset Condition Inspection & Photo Comparison — IndiAsset";
}

@section Styles {
    <style>
        .comparison-container {
            background: #1a1d27;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            overflow: hidden;
        }

        .comparison-panel {
            background: #1e2130;
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.06);
            overflow: hidden;
            height: 100%;
        }

        .comparison-img-wrap {
            height: 280px;
            width: 100%;
            background: #0f1117;
            position: relative;
        }

        .comparison-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .metric-badge {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 14px 18px;
        }
    </style>
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-11">

            <!-- Header -->
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
                <div>
                    <a asp-action="MyBookings" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 mb-2">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Leases
                    </a>
                    <h1 class="h2 fw-bold text-white mb-1">Asset Return Inspection &amp; Photo Comparison</h1>
                    <p class="text-muted mb-0">Visual comparison of equipment condition: Original baseline photos vs. post-lease returned photos.</p>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-light rounded-pill px-3 py-2 small" onclick="window.print()">
                        <i class="fa-solid fa-print me-1"></i> Print Report
                    </button>
                    <a asp-controller="Chat" asp-action="Index" asp-route-recipientId="@(Model.IsOwner ? Model.Booking.RenterId : Model.Booking.OwnerId)" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                        <i class="fa-regular fa-comments me-1"></i> Open Chat
                    </a>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Health & Settlement Summary Banner -->
            @{
                string scoreColorClass = Model.ConditionScore >= 90 ? "text-success" : (Model.ConditionScore >= 80 ? "text-info" : (Model.ConditionScore >= 65 ? "text-warning" : "text-danger"));
                string badgeBgClass = Model.ConditionScore >= 90 ? "bg-success" : (Model.ConditionScore >= 80 ? "bg-info" : (Model.ConditionScore >= 65 ? "bg-warning" : "bg-danger"));
                string scoreLabel = Model.ConditionScore >= 90 ? "Certified Quality" : (Model.ConditionScore >= 80 ? "Good Condition" : (Model.ConditionScore >= 65 ? "Moderate Wear" : "Damage Detected"));
            }
            <div class="card border-0 rounded-4 shadow-sm p-4 mb-4" style="background: linear-gradient(135deg, #1e2640 0%, #1a1d27 100%); border: 1px solid rgba(96, 165, 250, 0.25)!important;">
                <div class="row align-items-center g-4">
                    <div class="col-md-3 text-center border-end border-secondary border-opacity-25">
                        <div class="display-4 fw-bold @scoreColorClass mb-0">@Model.ConditionScore%</div>
                        <span class="badge @badgeBgClass bg-opacity-25 @scoreColorClass rounded-pill px-3 py-1 fw-bold mt-1">
                            <i class="fa-solid @(Model.ConditionScore >= 90 ? "fa-circle-check" : (Model.ConditionScore >= 80 ? "fa-shield-halved" : "fa-triangle-exclamation")) me-1"></i> @scoreLabel
                        </span>
                        <small class="text-muted d-block mt-2">Automated Visual Match</small>
                    </div>

                    <div class="col-md-5">
                        <h4 class="fw-bold text-white mb-1">@Model.Asset.Title</h4>
                        <p class="text-muted small mb-2">
                            Lease: <strong>@Model.Booking.StartDate.ToString("dd MMM yyyy") &ndash; @Model.Booking.EndDate.ToString("dd MMM yyyy")</strong> (@Model.Booking.TotalDays Days)
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            @if (Model.IsBaselineFromDispatch)
                            {
                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 small">
                                    <i class="fa-solid fa-camera me-1"></i> Handover Dispatch Baseline
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-25 text-white border border-secondary border-opacity-25 small">
                                    <i class="fa-solid fa-images me-1"></i> Catalog Baseline
                                </span>
                            }
                            <span class="badge bg-secondary bg-opacity-25 text-white border border-secondary border-opacity-25 small">
                                Cleanliness: @Model.CleanlinessStatus
                            </span>
                            <span class="badge bg-secondary bg-opacity-25 text-white border border-secondary border-opacity-25 small">
                                Operations: @Model.FunctionalStatus
                            </span>
                        </div>
                    </div>

                    <div class="col-md-4 text-md-end">
                        <span class="small text-muted d-block mb-1">Deposit Settlement</span>
                        @if (Model.DamageDeduction > 0)
                        {
                            <div class="fs-5 fw-bold text-danger mb-0">
                                -₹@Model.DamageDeduction.ToString("N0") Deducted
                            </div>
                            <div class="small text-success fw-bold mb-1">
                                Net Refund: ₹@Model.RecommendedRefundAmount.ToString("N0")
                            </div>
                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-1 fw-semibold small">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i> Damage Deduction Applied
                            </span>
                        }
                        else
                        {
                            <div class="fs-4 fw-bold text-success mb-1">
                                ₹@Model.RecommendedRefundAmount.ToString("N0") Refunded
                            </div>
                            <span class="badge bg-success text-white rounded-pill px-3 py-1.5 fw-semibold small">
                                <i class="fa-solid fa-check me-1"></i> Full Deposit Refund (₹0 Deductions)
                            </span>
                        }
                    </div>
                </div>
            </div>

            @if (Model.Payment != null)
            {
                <div class="card border-0 rounded-4 shadow-sm p-4 mb-4" style="background: linear-gradient(135deg, #152238 0%, #171d2b 100%); border: 1px solid rgba(34, 197, 94, 0.3) !important;">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="fa-solid fa-receipt fa-lg"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-white mb-0">Razorpay Lease Settlement Paid</h5>
                                <div class="small text-muted">
                                    Txn ID: <strong class="text-white font-monospace">@Model.Payment.TransactionId</strong> &bull;
                                    Gateway: <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25">Razorpay</span> &bull;
                                    Settled on: @(Model.Payment.PaidAt?.ToString("dd MMM yyyy, hh:mm tt") ?? Model.Payment.CreatedAt.ToString("dd MMM yyyy"))
                                </div>
                            </div>
                        </div>
                        <div class="text-md-end">
                            <span class="badge bg-success rounded-pill px-3 py-1.5 fw-bold">
                                <i class="fa-solid fa-circle-check me-1"></i> Paid ₹@Model.Payment.TotalAmount.ToString("N0")
                            </span>
                            <div class="small text-muted mt-1">Rent: ₹@Model.Payment.RentAmount.ToString("N0") + Deposit: ₹@Model.Payment.DepositAmount.ToString("N0")</div>
                        </div>
                    </div>
                </div>
            }

            <!-- ====================================================== -->
            <!-- SIDE-BY-SIDE VISUAL PHOTO COMPARISON -->
            <!-- ====================================================== -->
            <div class="comparison-container p-4 mb-4">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div>
                        <h4 class="fw-bold text-white mb-1">
                            <i class="fa-solid fa-code-compare text-primary me-2"></i>Side-by-Side Photo Comparison
                        </h4>
                        <p class="text-muted small mb-0">Compare the asset's pre-lease dispatch condition directly against the returned inspection photos.</p>
                    </div>
                    <span class="badge bg-primary rounded-pill px-3 py-2 fw-semibold">
                        Side-by-Side Analysis
                    </span>
                </div>

                @{
                    var maxCount = Math.Max(Model.BaselineImages.Count, Model.ReturnImages.Count);
                }

                @for (int i = 0; i < maxCount; i++)
                {
                    var baselineImg = i < Model.BaselineImages.Count ? Model.BaselineImages[i] : Model.BaselineImages.FirstOrDefault();
                    var returnImg = i < Model.ReturnImages.Count ? Model.ReturnImages[i] : Model.ReturnImages.FirstOrDefault();

                    <div class="row g-4 mb-4">
                        <!-- Left: Original Before Lease -->
                        <div class="col-md-6">
                            <div class="comparison-panel">
                                <div class="p-3 border-bottom border-secondary border-opacity-25 d-flex align-items-center justify-content-between">
                                    <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-25 rounded-pill px-2.5 py-1 fw-bold">
                                        <i class="fa-solid fa-camera-retro me-1"></i> BEFORE LEASE (Original Photo)
                                    </span>
                                    <small class="text-muted">Dispatch Baseline #@(i + 1)</small>
                                </div>
                                <div class="comparison-img-wrap">
                                    @if (!string.IsNullOrEmpty(baselineImg))
                                    {
                                        <img src="@baselineImg" alt="Original Condition Baseline" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                            <i class="fa-solid fa-cube fa-3x"></i>
                                        </div>
                                    }
                                </div>
                                <div class="p-3 small text-muted">
                                    <i class="fa-solid fa-circle-check text-info me-1"></i> Certified original listing image &bull; Clean initial condition
                                </div>
                            </div>
                        </div>

                        <!-- Right: Post-Use Return -->
                        <div class="col-md-6">
                            <div class="comparison-panel">
                                <div class="p-3 border-bottom border-secondary border-opacity-25 d-flex align-items-center justify-content-between">
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1 fw-bold">
                                        <i class="fa-solid fa-camera me-1"></i> AFTER LEASE (Returned Photo)
                                    </span>
                                    <small class="text-muted">Return Inspection #@(i + 1)</small>
                                </div>
                                <div class="comparison-img-wrap">
                                    @if (!string.IsNullOrEmpty(returnImg))
                                    {
                                        <img src="@returnImg" alt="Return Inspection Photo" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                            <i class="fa-solid fa-image fa-3x"></i>
                                        </div>
                                    }
                                </div>
                                <div class="p-3 small text-muted">
                                    <i class="fa-solid fa-circle-check text-success me-1"></i> Uploaded upon return &bull; Verified zero structural damage
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (!Model.BaselineImages.Any() && !Model.ReturnImages.Any())
                {
                    <div class="p-5 text-center text-muted">
                        <i class="fa-solid fa-images fa-3x mb-3 text-secondary opacity-50"></i>
                        <p>No comparison images available for this lease.</p>
                    </div>
                }
            </div>

            <!-- Return Remarks & Inspection Log -->
            <div class="card border-0 rounded-4 shadow-sm p-4 mb-4" style="background-color: #1a1d27;">
                <h5 class="fw-bold text-white mb-3">
                    <i class="fa-solid fa-clipboard-list text-primary me-2"></i>Return Inspection &amp; Damage Analysis Log
                </h5>
                <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-25 text-light small mb-3">
                    <strong>Renter's Return Note:</strong> @(Model.LeaseReturn?.ConditionAfter ?? "Asset returned in clean, operational condition with verified photos.")
                </div>

                @if (!string.IsNullOrEmpty(Model.LeaseReturn?.ComparisonSummary))
                {
                    <div class="p-3 rounded-3 mb-3 @(Model.DamageDeduction > 0 ? "bg-danger bg-opacity-10 border border-danger border-opacity-25" : "bg-success bg-opacity-10 border border-success border-opacity-25")">
                        <div class="d-flex align-items-start gap-2">
                            <i class="fa-solid @(Model.DamageDeduction > 0 ? "fa-triangle-exclamation text-danger" : "fa-circle-check text-success") mt-1"></i>
                            <div>
                                <strong class="text-white">Automated Photo Comparison Analysis:</strong>
                                <p class="text-muted mb-0 small mt-1">@Model.LeaseReturn.ComparisonSummary</p>
                            </div>
                        </div>
                    </div>
                }

                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="metric-badge">
                            <span class="text-muted small d-block mb-1">Returned At</span>
                            <span class="fw-semibold text-white">@(Model.LeaseReturn?.ReturnedAt?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") ?? DateTime.Now.ToString("dd MMM yyyy"))</span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="metric-badge">
                            <span class="text-muted small d-block mb-1">Escrow Deposit</span>
                            <span class="fw-semibold text-info">₹@Model.SecurityDeposit.ToString("N0")</span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="metric-badge">
                            <span class="text-muted small d-block mb-1">Damage Deduction</span>
                            @if (Model.DamageDeduction > 0)
                            {
                                <span class="fw-semibold text-danger">-₹@Model.DamageDeduction.ToString("N0")</span>
                            }
                            else
                            {
                                <span class="fw-semibold text-success">₹0 (Zero Damage)</span>
                            }
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="metric-badge">
                            <span class="text-muted small d-block mb-1">Net Refund to Renter</span>
                            <span class="fw-semibold text-success">₹@Model.RecommendedRefundAmount.ToString("N0")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ====================================================== -->
            <!-- DISPUTE WORKFLOW & SETTLEMENT CONTROLS -->
            <!-- ====================================================== -->
            @if (Model.IsDisputed)
            {
                <div class="card border-0 rounded-4 shadow-sm p-4 mb-4" style="background: rgba(239, 68, 68, 0.06); border: 1px solid rgba(239, 68, 68, 0.3) !important;">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-scale-balanced fa-lg text-danger"></i>
                            <h5 class="fw-bold text-white mb-0">Renter Dispute on Damage Deduction</h5>
                        </div>
                        <span class="badge @(Model.DisputeStatus == "Resolved" ? "bg-success" : (Model.DisputeStatus == "AcceptedByRenter" ? "bg-info" : "bg-danger")) rounded-pill px-3 py-1.5 fw-semibold">
                            Status: @Model.DisputeStatus
                        </span>
                    </div>

                    <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-25 mb-3">
                        <div class="text-secondary small mb-1">Renter's Dispute Statement:</div>
                        <div class="text-white">"@Model.DisputeReason"</div>
                        @if (Model.DisputedAt.HasValue)
                        {
                            <div class="text-secondary small mt-1">Submitted on @Model.DisputedAt.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div>
                        }
                    </div>

                    @if (Model.DisputeImages != null && Model.DisputeImages.Any())
                    {
                        <div class="mb-3">
                            <div class="text-secondary small mb-2 fw-semibold">Renter Rebuttal Evidence Photos:</div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var img in Model.DisputeImages)
                                {
                                    <a href="@img" target="_blank" class="rounded-3 overflow-hidden border border-secondary border-opacity-25" style="width: 100px; height: 75px; display: inline-block;">
                                        <img src="@img" style="width: 100%; height: 100%; object-fit: cover;" alt="Dispute evidence" />
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.DisputeResolutionNotes))
                    {
                        <div class="p-3 rounded-3 bg-success bg-opacity-10 border border-success border-opacity-25 text-success small mb-3">
                            <strong>Resolution Notes:</strong> @Model.DisputeResolutionNotes
                        </div>
                    }

                    @if (Model.IsOwner && Model.DisputeStatus == "Open")
                    {
                        <div class="mt-3 pt-3 border-top border-secondary border-opacity-25">
                            <h6 class="fw-bold text-white mb-2">Resolve Renter Dispute</h6>
                            <form asp-controller="Booking" asp-action="ResolveDispute" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookingId" value="@Model.Booking.Id" />
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label text-muted small">Final Adjusted Damage Deduction (₹)</label>
                                        <input type="number" name="adjustedDamageDeduction" class="form-control bg-dark border-secondary text-white" value="0" min="0" max="@Model.SecurityDeposit" step="100" required />
                                        <div class="form-text text-muted small">Set ₹0 to fully waive, or enter mutually agreed amount.</div>
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label text-muted small">Resolution Decision & Remarks</label>
                                        <input type="text" name="resolutionNotes" class="form-control bg-dark border-secondary text-white" placeholder="e.g. Reviewed photos, accepted wear as pre-existing, waived deduction." required />
                                    </div>
                                    <div class="col-md-3 d-flex align-items-end">
                                        <button type="submit" name="decision" value="Resolved" class="btn btn-success w-100 rounded-pill fw-semibold py-2">
                                            <i class="fa-solid fa-handshake me-1"></i> Resolve Dispute
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    }
                </div>
            }
            else if (!Model.IsOwner && Model.DamageDeduction > 0)
            {
                <div class="card border-0 rounded-4 shadow-sm p-4 mb-4" style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.25) !important;">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <div>
                            <h5 class="fw-bold text-white mb-1">
                                <i class="fa-solid fa-circle-question text-warning me-2"></i>Damage Deduction Settlement Action
                            </h5>
                            <p class="text-muted small mb-0">A deduction of ₹@Model.DamageDeduction.ToString("N0") was recorded from your escrow deposit. You can accept this settlement or raise a formal dispute with rebuttal photos.</p>
                        </div>
                        <div class="d-flex gap-2">
                            <form asp-controller="Booking" asp-action="AcceptSettlement" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookingId" value="@Model.Booking.Id" />
                                <button type="submit" class="btn btn-outline-success rounded-pill px-4 py-2 fw-semibold">
                                    <i class="fa-solid fa-check me-1"></i> Accept Settlement
                                </button>
                            </form>
                            <button type="button" class="btn btn-danger rounded-pill px-4 py-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#disputeModal">
                                <i class="fa-solid fa-scale-balanced me-1"></i> Raise Dispute
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- Owner Damage Deduction Adjustment Panel -->
            @if (Model.IsOwner)
            {
                <div class="card border-0 rounded-4 shadow-sm p-4 mb-4" style="background: #181d29; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                        <div>
                            <h5 class="fw-bold text-white mb-1">
                                <i class="fa-solid fa-sliders text-primary me-2"></i>Owner Settlement Controls
                            </h5>
                            <p class="text-muted small mb-0">As the asset owner, you can adjust the damage deduction or waive minor scratches before final release.</p>
                        </div>
                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" type="button" data-bs-toggle="collapse" data-bs-target="#adjustDeductionCollapse">
                            <i class="fa-solid fa-pen-to-square me-1"></i> Adjust Deduction
                        </button>
                    </div>

                    <div class="collapse" id="adjustDeductionCollapse">
                        <form asp-controller="Booking" asp-action="AdjustDamageDeduction" method="post" class="mt-3 pt-3 border-top border-secondary border-opacity-25">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookingId" value="@Model.Booking.Id" />
                            <div class="row g-3 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label text-muted small">Damage Deduction (₹)</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-dark border-secondary text-white">₹</span>
                                        <input type="number" name="damageDeduction" class="form-control bg-dark border-secondary text-white" 
                                               value="@Model.DamageDeduction" min="0" max="@Model.SecurityDeposit" step="100" required />
                                    </div>
                                    <div class="form-text text-muted small">Max: ₹@Model.SecurityDeposit.ToString("N0") (Deposit amount)</div>
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label text-muted small">Adjustment Note / Reason</label>
                                    <input type="text" name="reason" class="form-control bg-dark border-secondary text-white" 
                                           placeholder="e.g. Waived minor scratch / Agreed after phone call" />
                                </div>
                                <div class="col-md-3">
                                    <button type="submit" class="btn btn-warning w-100 rounded-pill fw-semibold py-2">
                                        <i class="fa-solid fa-check me-1"></i> Save Adjustment
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }

            <!-- ====================================================== -->
            <!-- USER RATING & REVIEW CARD -->
            <!-- ====================================================== -->
            @if (Model.Review != null)
            {
                <div class="card border-0 rounded-4 shadow-sm p-4 mb-4" style="background-color: #1a1d27;">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="fw-bold text-white mb-0">
                            <i class="fa-solid fa-star text-warning me-2"></i>Renter Experience Review
                        </h5>
                        <div class="text-warning fs-5">
                            @for (int s = 1; s <= 5; s++)
                            {
                                if (s <= Model.Review.Rating)
                                {
                                    <i class="fa-solid fa-star"></i>
                                }
                                else
                                {
                                    <i class="fa-regular fa-star text-secondary"></i>
                                }
                            }
                            <span class="text-white small fw-bold ms-2">(@Model.Review.Rating / 5)</span>
                        </div>
                    </div>

                    <div class="p-3.5 rounded-3 bg-dark border border-secondary border-opacity-25 mb-3">
                        <p class="text-light mb-0 fs-6 fst-italic">
                            &ldquo;@Model.Review.Comment&rdquo;
                        </p>
                    </div>

                    <div class="d-flex align-items-center justify-content-between small text-muted">
                        <div>
                            Reviewed by: <strong class="text-white">@Model.RenterName</strong>
                        </div>
                        <div>
                            @Model.Review.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy")
                        </div>
                    </div>
                </div>
            }

            <div class="text-center pt-2">
                <a asp-action="MyBookings" class="btn btn-outline-primary rounded-pill px-5 py-2.5 fw-semibold">
                    <i class="fa-solid fa-arrow-left me-1"></i> Return to Leases Dashboard
                </a>
            </div>

        </div>
    </div>
</div>

<!-- DISPUTE REBUTTAL MODAL -->
<div class="modal fade" id="disputeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4" style="background: #181d29; border: 1px solid rgba(255, 255, 255, 0.1) !important;">
            <form asp-controller="Booking" asp-action="RaiseDispute" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" value="@Model.Booking.Id" />
                <div class="modal-header border-secondary border-opacity-25">
                    <h5 class="modal-title fw-bold text-white">
                        <i class="fa-solid fa-scale-balanced text-danger me-2"></i>Dispute Damage Deduction
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary small mb-3">Explain why you believe the ₹@Model.DamageDeduction.ToString("N0") damage deduction is inaccurate. You can attach rebuttal photos demonstrating pre-existing condition or operational wear.</p>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Explanation / Rebuttal Reason</label>
                        <textarea name="reason" rows="3" class="form-control bg-dark border-secondary text-white" placeholder="Describe the condition, pre-existing wear, or angle discrepancy..." required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Rebuttal Evidence Photos (Optional)</label>
                        <input type="file" name="rebuttalPhotos" multiple accept="image/*" class="form-control bg-dark border-secondary text-white" />
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">
                        <i class="fa-solid fa-paper-plane me-1"></i> Submit Dispute
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

