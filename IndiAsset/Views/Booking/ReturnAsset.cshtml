@model IndiAsset.Models.ReturnAssetUploadViewModel
@{
    ViewData["Title"] = "Return Asset & Settlement Payment — IndiAsset";
}

@section Styles {
    <style>
        .upload-dropzone {
            border: 2px dashed rgba(96, 165, 250, 0.4);
            background: rgba(37, 99, 235, 0.04);
            border-radius: 18px;
            padding: 30px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
        }

        .upload-dropzone:hover {
            border-color: #3b82f6;
            background: rgba(37, 99, 235, 0.08);
        }

        .baseline-photo-card {
            border-radius: 14px;
            overflow: hidden;
            background: #1e2130;
            border: 1px solid rgba(255, 255, 255, 0.08);
            position: relative;
        }

        .rating-star-btn {
            background: transparent;
            border: none;
            color: #475569;
            font-size: 1.8rem;
            cursor: pointer;
            transition: color 0.15s;
        }

        .rating-star-btn.active {
            color: #f59e0b;
        }

        .payment-highlight-box {
            background: rgba(37, 99, 235, 0.08);
            border: 1px solid rgba(59, 130, 246, 0.25);
            border-radius: 14px;
            padding: 16px 20px;
        }
    </style>
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
                <div>
                    <a asp-action="MyBookings" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 mb-2">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Leases
                    </a>
                    <h1 class="h2 fw-bold text-white mb-1">Return Asset &amp; Lease Settlement</h1>
                    <p class="text-muted mb-0">Complete condition inspection with verified post-use photos and settle the lease payment via Razorpay.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-2 fs-6">
                        <i class="fa-brands fa-razorpay me-1"></i> Razorpay Secured
                    </span>
                </div>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey("RazorpayPaymentId"))
            {
                <div class="alert alert-danger rounded-4 p-3 mb-4 d-flex align-items-center gap-3">
                    <i class="fa-solid fa-triangle-exclamation fa-2x"></i>
                    <div>
                        <div class="fw-bold">Payment Required</div>
                        <div>@ViewData.ModelState["RazorpayPaymentId"]?.Errors.FirstOrDefault()?.ErrorMessage</div>
                    </div>
                </div>
            }

            <!-- Lease Overview Card -->
            <div class="card border-0 rounded-4 shadow-sm p-4 mb-4" style="background-color: #1a1d27;">
                <div class="row align-items-center g-3">
                    <div class="col-md-2 text-center text-md-start">
                        <div class="rounded-3 overflow-hidden bg-dark d-inline-block border border-secondary border-opacity-25" style="width: 100px; height: 100px;">
                            @if (!string.IsNullOrEmpty(Model.PrimaryImageUrl))
                            {
                                <img src="@Model.PrimaryImageUrl" class="w-100 h-100 object-fit-cover" alt="@Model.AssetTitle" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                    <i class="fa-solid fa-cube fa-2x"></i>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <span class="badge bg-secondary bg-opacity-25 text-white rounded-pill px-2.5 py-1 mb-1">@Model.AssetCategory</span>
                        <h4 class="fw-bold text-white mb-1">@Model.AssetTitle</h4>
                        <p class="small text-muted mb-0">
                            Owner: <strong class="text-white">@Model.OwnerName</strong> &bull;
                            Renter: <strong class="text-white">@Model.RenterName</strong>
                        </p>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <div class="small text-muted mb-1">
                            <i class="fa-regular fa-calendar me-1"></i> @Model.TotalDays Days Lease
                        </div>
                        <div class="small text-muted mb-1">
                            @Model.StartDate.ToString("dd MMM yyyy") &ndash; @Model.EndDate.ToString("dd MMM yyyy")
                        </div>
                        <div class="fw-bold text-primary fs-5">
                            Settlement: ₹@Model.AmountToPay.ToString("N0")
                        </div>
                    </div>
                </div>
            </div>

            <!-- Return Inspection Form -->
            <form method="post" enctype="multipart/form-data" asp-action="ReturnAsset" id="returnAssetForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BookingId" />
                <input type="hidden" asp-for="AssetId" />
                <input type="hidden" asp-for="AssetTitle" />
                <input type="hidden" asp-for="SecurityDeposit" />
                <input type="hidden" asp-for="TotalRent" />
                <input type="hidden" asp-for="DailyRent" />
                <input type="hidden" asp-for="TotalDays" />
                <input type="hidden" asp-for="TotalAmount" />
                <input type="hidden" asp-for="AmountToPay" id="rzpAmountToPay" />

                <!-- Razorpay Hidden Transaction Inputs -->
                <input type="hidden" asp-for="RazorpayKeyId" id="rzpKeyId" />
                <input type="hidden" asp-for="RazorpayOrderId" id="rzpOrderId" />
                <input type="hidden" asp-for="RazorpayPaymentId" id="rzpPaymentId" />
                <input type="hidden" asp-for="RazorpaySignature" id="rzpSignature" />
                <input type="hidden" asp-for="IsSimulationMode" id="isSimulationMode" />

                <!-- 1. BASELINE ORIGINAL PHOTOS (BEFORE LEASE) -->
                <div class="card border-0 rounded-4 shadow-sm p-4 mb-4" style="background-color: #1a1d27;">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="fw-bold text-white mb-0">
                            <i class="fa-solid fa-images text-info me-2"></i>1. Original Pre-Lease Photos (Baseline Condition)
                        </h5>
                        <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-2.5 py-1">
                            Certified Dispatch State
                        </span>
                    </div>
                    <p class="text-muted small mb-3">
                        These are the certified photos taken when the asset was listed and dispatched. Your post-use photos will be compared side-by-side against these:
                    </p>

                    <div class="row g-3">
                        @if (Model.BaselineOriginalImageUrls.Any())
                        {
                            @foreach (var img in Model.BaselineOriginalImageUrls)
                            {
                                <div class="col-6 col-md-3">
                                    <div class="baseline-photo-card h-100">
                                        <img src="@img" class="w-100 object-fit-cover" style="height: 140px;" alt="Baseline condition" />
                                        <div class="p-2 text-center small text-muted">
                                            <i class="fa-solid fa-check-circle text-success me-1"></i> Original State
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12 text-muted small">No baseline photos recorded for this asset.</div>
                        }
                    </div>
                </div>

                <!-- 2. POST-USE RETURN PHOTOS (AFTER LEASE) (STORED DIRECTLY IN MONGODB ATLAS GRIDFS) -->
                <div class="card border-0 rounded-4 shadow-sm p-4 mb-4" style="background-color: #1a1d27;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h5 class="fw-bold text-white mb-0">
                            <i class="fa-solid fa-cloud-arrow-up text-primary me-2"></i>2. Upload Post-Use Return Photos (Saved in MongoDB Atlas GridFS)
                        </h5>
                        <span class="badge bg-warning bg-opacity-25 text-warning rounded-pill px-2.5 py-1">
                            Required for Inspection
                        </span>
                    </div>
                    <p class="text-muted small mb-3">
                        Capture photos of the equipment now (front, controls, engine/body, overall view) to demonstrate its current working condition. Images are securely stored in MongoDB Atlas GridFS and visible across all devices.
                    </p>

                    <div class="upload-dropzone mb-3" onclick="document.getElementById('returnFileInput').click();">
                        <i class="fa-solid fa-camera-retro fa-3x text-primary mb-2"></i>
                        <h6 class="fw-bold text-white mb-1">Click or drag photos to upload</h6>
                        <p class="text-muted small mb-0">Support JPG, PNG, WEBP files up to 25MB each &bull; Stored in Cloud Database</p>
                        <input type="file" id="returnFileInput" name="ReturnPhotos" multiple accept="image/*" class="d-none" onchange="previewReturnPhotos(this)" required />
                    </div>

                    <div id="photoPreviewContainer" class="row g-3 d-none">
                        <!-- Dynamic photo previews will appear here -->
                    </div>
                    <span asp-validation-for="ReturnPhotos" class="text-danger small"></span>
                </div>

                <!-- 3. CONDITION ASSESSMENT & NOTES -->
                <div class="card border-0 rounded-4 shadow-sm p-4 mb-4" style="background-color: #1a1d27;">
                    <h5 class="fw-bold text-white mb-3">
                        <i class="fa-solid fa-clipboard-check text-success me-2"></i>3. Operational Condition Notes
                    </h5>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Condition Status &amp; Return Remarks</label>
                        <textarea asp-for="ConditionNotes" class="form-control rounded-3" rows="3"
                                  placeholder="e.g. Asset returned in full working order, fuel tank refilled, cleaned after site use, all attachments intact."></textarea>
                    </div>
                </div>

                <!-- 4. RATING & REVIEW -->
                <div class="card border-0 rounded-4 shadow-sm p-4 mb-4" style="background-color: #1a1d27;">
                    <h5 class="fw-bold text-white mb-2">
                        <i class="fa-solid fa-star text-warning me-2"></i>4. Review Your Asset Leasing Experience
                    </h5>
                    <p class="text-muted small mb-3">Rate how smoothly the equipment performed during your lease.</p>

                    <div class="mb-3 text-center py-2">
                        <input type="hidden" asp-for="Rating" id="ratingInput" value="5" />
                        <div class="d-inline-flex gap-2" id="starRatingGroup">
                            <button type="button" class="rating-star-btn active" data-score="1" onclick="setRating(1)"><i class="fa-solid fa-star"></i></button>
                            <button type="button" class="rating-star-btn active" data-score="2" onclick="setRating(2)"><i class="fa-solid fa-star"></i></button>
                            <button type="button" class="rating-star-btn active" data-score="3" onclick="setRating(3)"><i class="fa-solid fa-star"></i></button>
                            <button type="button" class="rating-star-btn active" data-score="4" onclick="setRating(4)"><i class="fa-solid fa-star"></i></button>
                            <button type="button" class="rating-star-btn active" data-score="5" onclick="setRating(5)"><i class="fa-solid fa-star"></i></button>
                        </div>
                        <div class="small text-warning fw-semibold mt-1" id="ratingText">5 Stars — Excellent Performance</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Write Your Review</label>
                        <textarea asp-for="ReviewComment" class="form-control rounded-3" rows="3" required
                                  placeholder="Share how the equipment functioned, owner responsiveness, and delivery experience..."></textarea>
                        <span asp-validation-for="ReviewComment" class="text-danger small"></span>
                    </div>
                </div>

                <!-- 5. LEASE RETURN SETTLEMENT & RAZORPAY PAYMENT (MANDATORY TO RETURN ASSET) -->
                <div class="card border-0 rounded-4 shadow-sm p-4 mb-4" style="background: linear-gradient(135deg, #1b2138 0%, #151824 100%); border: 1px solid rgba(59, 130, 246, 0.3) !important;">
                    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                        <h5 class="fw-bold text-white mb-0">
                            <i class="fa-brands fa-razorpay text-primary me-2"></i>5. Lease Settlement Payment (Razorpay)
                        </h5>
                        <span class="badge bg-primary text-white rounded-pill px-3 py-1.5 fw-semibold small">
                            <i class="fa-solid fa-shield-halved me-1"></i> Payment Required on Return
                        </span>
                    </div>

                    <p class="text-muted small mb-4">
                        To finalize the equipment return and release the asset, please complete the lease settlement payment via Razorpay. Security deposit remains protected in escrow until physical visual verification.
                    </p>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="payment-highlight-box h-100">
                                <div class="small text-muted mb-1">Rental Total (@Model.TotalDays days &times; ₹@Model.DailyRent.ToString("N0"))</div>
                                <div class="fs-4 fw-bold text-white">₹@Model.TotalRent.ToString("N0")</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="payment-highlight-box h-100">
                                <div class="small text-muted mb-1">Pre-Paid Escrow Deposit Adjusted</div>
                                <div class="fs-4 fw-bold text-info">-₹@Model.DepositAdjusted.ToString("N0")</div>
                                @if (Model.IsDepositAlreadyPaid)
                                {
                                    <small class="text-success"><i class="fa-solid fa-shield-check me-1"></i>Paid into escrow prior to lease</small>
                                }
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="payment-highlight-box h-100" style="background: rgba(34, 197, 94, 0.08); border-color: rgba(34, 197, 94, 0.3);">
                                <div class="small text-muted mb-1">Net Settlement Payable</div>
                                <div class="fs-4 fw-bold text-success">₹@Model.AmountToPay.ToString("N0")</div>
                                @if (Model.ExcessDepositRefund > 0)
                                {
                                    <small class="text-warning"><i class="fa-solid fa-arrow-rotate-left me-1"></i>₹@Model.ExcessDepositRefund.ToString("N0") excess refund to be processed</small>
                                }
                                else
                                {
                                    <small class="text-muted">(Rental ₹@Model.TotalRent.ToString("N0") - Deposit ₹@Model.DepositAdjusted.ToString("N0"))</small>
                                }
                            </div>
                        </div>
                    </div>

                    @if (Model.AmountToPay <= 0)
                    {
                        <div class="alert alert-success rounded-3 p-3 mb-3 d-flex align-items-center gap-3 border border-success border-opacity-25" style="background: rgba(34, 197, 94, 0.12);">
                            <i class="fa-solid fa-circle-check fa-2x text-success"></i>
                            <div>
                                <div class="fw-bold text-success">Escrow Security Deposit Fully Covers Rental Fee!</div>
                                <div class="small text-white-70">
                                    Your upfront escrow security deposit of ₹@Model.DepositAdjusted.ToString("N0") fully covers the total rental charge of ₹@Model.TotalRent.ToString("N0").
                                    No additional gateway settlement payment is required.
                                    @if (Model.ExcessDepositRefund > 0)
                                    {
                                        <span class="d-block mt-1 text-warning fw-semibold">
                                            <i class="fa-solid fa-arrow-rotate-left me-1"></i>Remaining excess deposit of ₹@Model.ExcessDepositRefund.ToString("N0") will be returned to your source account.
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Payment Action Area -->
                        <div id="paymentPendingBox" class="p-3 rounded-3 mb-2" style="background: rgba(255, 255, 255, 0.03); border: 1px dashed rgba(255, 255, 255, 0.15);">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                <div>
                                    <div class="fw-semibold text-white mb-0">
                                        <i class="fa-solid fa-clock text-warning me-1"></i> Return Settlement Pending
                                    </div>
                                    <small class="text-muted">Pay ₹@Model.AmountToPay.ToString("N0") (Rent ₹@Model.TotalRent.ToString("N0") minus Deposit ₹@Model.DepositAdjusted.ToString("N0")) via Razorpay.</small>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <button type="button" class="btn btn-primary rounded-pill px-4 py-2.5 fw-semibold shadow" id="btnRazorpayPay" onclick="openRazorpayCheckout()">
                                        <i class="fa-solid fa-credit-card me-1"></i> Pay ₹@Model.AmountToPay.ToString("N0") via Razorpay
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 py-2 small" onclick="simulateTestPayment()" title="Click to test without external gateway">
                                        <i class="fa-solid fa-vial me-1"></i> Test Pay (Dev)
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Payment Success Badge (Hidden until paid) -->
                        <div id="paymentSuccessBox" class="p-3 rounded-3 mb-2 d-none" style="background: rgba(34, 197, 94, 0.12); border: 1px solid rgba(34, 197, 94, 0.4);">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                                        <i class="fa-solid fa-check fa-lg"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-success mb-0">Payment Received &amp; Verified via Razorpay!</div>
                                        <small class="text-white-50">Transaction ID: <span id="confirmedPaymentId" class="font-monospace text-white fw-bold"></span></small>
                                    </div>
                                </div>
                                <span class="badge bg-success text-white rounded-pill px-3 py-2">
                                    <i class="fa-solid fa-lock-check me-1"></i> Ready for Submission
                                </span>
                            </div>
                        </div>

                        <div class="text-danger small mt-2" id="paymentErrorText"></div>
                    }
                </div>

                <!-- SUBMIT BUTTON -->
                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a asp-action="MyBookings" class="btn btn-outline-secondary rounded-pill px-4 py-2.5">
                        Cancel
                    </a>
                    <button type="button" class="btn btn-primary rounded-pill px-5 py-2.5 fw-semibold shadow-sm fs-6" id="btnSubmitReturn" onclick="handleReturnFormSubmit()">
                        <i class="fa-solid fa-code-compare me-1"></i> @(Model.AmountToPay <= 0 ? "Submit Asset Return & Comparison Report" : "Pay & Submit Asset Return")
                    </button>
                </div>
            </form>

        </div>
    </div>
<!-- Razorpay Sandbox Simulator Modal -->
<div class="modal fade" id="razorpaySimulatorModal" tabindex="-1" aria-labelledby="razorpaySimulatorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden" style="background: #111420; color: #f1f5f9; border: 1px solid rgba(59, 130, 246, 0.3) !important;">
            <!-- Modal Header with Razorpay Branding -->
            <div class="modal-header border-bottom border-light border-opacity-10 py-3 px-4" style="background: linear-gradient(135deg, #0c2340 0%, #172554 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary bg-opacity-25 border border-primary border-opacity-50 p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="fa-brands fa-razorpay text-primary fa-lg"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h6 class="modal-title fw-bold text-white mb-0" id="razorpaySimulatorModalLabel">Razorpay Gateway</h6>
                            <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-25 rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">
                                <i class="fa-solid fa-flask me-1"></i> TEST SIMULATOR
                            </span>
                        </div>
                        <small class="text-white-50">IndiAsset Equipment Settlement &bull; Secure Checkout</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <!-- Order Summary Bar -->
                <div class="d-flex justify-content-between align-items-center p-3 rounded-3 mb-3" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <div>
                        <small class="text-muted d-block">Settlement for</small>
                        <span class="fw-semibold text-white">@Model.AssetTitle</span>
                    </div>
                    <div class="text-end">
                        <small class="text-muted d-block">Amount Due</small>
                        <span class="fs-4 fw-bold text-success">₹@Model.AmountToPay.ToString("N0")</span>
                    </div>
                </div>

                <!-- Simulation Mode Notice -->
                <div class="alert alert-info border-0 rounded-3 p-2.5 mb-3 d-flex align-items-start gap-2" style="background: rgba(59, 130, 246, 0.12); color: #93c5fd; font-size: 0.825rem;">
                    <i class="fa-solid fa-circle-info mt-1"></i>
                    <div>
                        <strong>Developer Simulation Mode:</strong> Simulated gateway active for seamless local testing. Click any option below to simulate verified authorization.
                    </div>
                </div>

                <!-- Payment Method Tabs -->
                <ul class="nav nav-pills nav-fill mb-3 gap-2" id="simPaymentTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-pill py-2 small fw-semibold" id="sim-upi-tab" data-bs-toggle="pill" data-bs-target="#sim-upi" type="button" role="tab">
                            <i class="fa-solid fa-qrcode me-1"></i> UPI / QR
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill py-2 small fw-semibold" id="sim-card-tab" data-bs-toggle="pill" data-bs-target="#sim-card" type="button" role="tab">
                            <i class="fa-solid fa-credit-card me-1"></i> Cards
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill py-2 small fw-semibold" id="sim-net-tab" data-bs-toggle="pill" data-bs-target="#sim-net" type="button" role="tab">
                            <i class="fa-solid fa-building-columns me-1"></i> NetBanking
                        </button>
                    </li>
                </ul>

                <div class="tab-content mb-4" id="simPaymentContent">
                    <!-- UPI Tab -->
                    <div class="tab-pane fade show active" id="sim-upi" role="tabpanel">
                        <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06);">
                            <label class="form-label small text-muted mb-1">Simulated Virtual Payment Address (VPA)</label>
                            <div class="input-group input-group-sm mb-2">
                                <span class="input-group-text"><i class="fa-solid fa-at text-primary"></i></span>
                                <input type="text" class="form-control" id="simUpiId" value="@(User.Identity?.Name?.Split('@')[0] ?? "renter")@@razorpay" readonly />
                            </div>
                            <div class="d-flex gap-2">
                                <span class="badge bg-secondary bg-opacity-25 text-white-50 small">Google Pay</span>
                                <span class="badge bg-secondary bg-opacity-25 text-white-50 small">PhonePe</span>
                                <span class="badge bg-secondary bg-opacity-25 text-white-50 small">Paytm</span>
                            </div>
                        </div>
                    </div>

                    <!-- Cards Tab -->
                    <div class="tab-pane fade" id="sim-card" role="tabpanel">
                        <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06);">
                            <label class="form-label small text-muted mb-1">Razorpay Test Card</label>
                            <div class="input-group input-group-sm mb-2">
                                <span class="input-group-text"><i class="fa-solid fa-credit-card text-primary"></i></span>
                                <input type="text" class="form-control" value="4012 &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; 1881 (Visa Test)" readonly />
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="text" class="form-control form-control-sm" value="Expires: 12/29" readonly />
                                </div>
                                <div class="col-6">
                                    <input type="text" class="form-control form-control-sm" value="CVV: 123" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- NetBanking Tab -->
                    <div class="tab-pane fade" id="sim-net" role="tabpanel">
                        <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06);">
                            <label class="form-label small text-muted mb-1">Select Simulated Bank</label>
                            <select class="form-select form-select-sm" id="simBankSelect">
                                <option selected>HDFC Bank (Test Simulator)</option>
                                <option>ICICI Bank (Test Simulator)</option>
                                <option>State Bank of India (Test Simulator)</option>
                                <option>Axis Bank (Test Simulator)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Simulation Action Button -->
                <button type="button" class="btn btn-primary w-100 py-2.5 rounded-pill fw-semibold shadow-sm" id="btnExecuteSimulatedPay" onclick="executeSimulatedRazorpayPayment()">
                    <i class="fa-solid fa-shield-check me-1"></i> Authorize &amp; Pay ₹@Model.AmountToPay.ToString("N0")
                </button>

                <div class="text-center mt-3">
                    <small class="text-white-50" style="font-size: 0.75rem;">
                        <i class="fa-solid fa-lock me-1"></i> 256-Bit SSL Encrypted Razorpay Handshake Simulation
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Load official Razorpay Checkout SDK -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
    let isPaymentDone = @(Model.AmountToPay <= 0 ? "true" : "false");

    function setRating(val) {
        document.getElementById('ratingInput').value = val;
        const btns = document.querySelectorAll('.rating-star-btn');
        btns.forEach((btn, idx) => {
            if (idx < val) {
                btn.classList.add('active');
            } else {
                btn.classList.remove('active');
            }
        });

        const labels = [
            "1 Star — Unsatisfactory",
            "2 Stars — Below Average",
            "3 Stars — Average Condition",
            "4 Stars — Good Equipment",
            "5 Stars — Excellent Performance"
        ];
        document.getElementById('ratingText').innerText = labels[val - 1];
    }

    function previewReturnPhotos(input) {
        const container = document.getElementById('photoPreviewContainer');
        container.innerHTML = '';
        if (input.files && input.files.length > 0) {
            container.classList.remove('d-none');
            Array.from(input.files).forEach(file => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const col = document.createElement('div');
                    col.className = 'col-6 col-md-3';
                    col.innerHTML = `
                        <div class="rounded-3 overflow-hidden bg-dark border border-primary border-opacity-50 position-relative" style="height: 140px;">
                            <img src="${e.target.result}" class="w-100 h-100 object-fit-cover" />
                            <span class="badge bg-primary position-absolute bottom-0 start-0 m-1.5 small">Return Photo</span>
                        </div>
                    `;
                    container.appendChild(col);
                };
                reader.readAsDataURL(file);
            });
        }
    }

    function openRazorpayCheckout() {
        const keyId = document.getElementById('rzpKeyId').value;
        const orderId = document.getElementById('rzpOrderId').value;
        const isSimMode = document.getElementById('isSimulationMode')?.value === 'True' ||
                          document.getElementById('isSimulationMode')?.value === 'true' ||
                          !orderId ||
                          orderId.startsWith('order_sim_') ||
                          orderId.startsWith('order_demo_') ||
                          orderId.startsWith('order_test_') ||
                          !keyId ||
                          keyId.includes('1DP5mmOl') ||
                          keyId.includes('DemoKey') ||
                          keyId.includes('YourKey') ||
                          keyId.includes('IndiAsset');

        // If in simulation mode or keys are unconfigured, open the simulator modal directly
        // (passing a dummy order_id to checkout.razorpay.com will cause Razorpay's modal to fail with "Something went wrong")
        if (isSimMode) {
            openRazorpaySimulatorModal();
            return;
        }

        const amount = parseFloat(document.getElementById('rzpAmountToPay').value) || 100;
        const amountPaise = Math.round(amount * 100);

        const options = {
            "key": keyId,
            "amount": amountPaise,
            "currency": "INR",
            "name": "IndiAsset Platform",
            "description": "Lease Return Settlement - @Model.AssetTitle",
            "image": "@(string.IsNullOrEmpty(Model.PrimaryImageUrl) ? "https://cdn-icons-png.flaticon.com/512/3135/3135715.png" : Model.PrimaryImageUrl)",
            "order_id": orderId,
            "handler": function (response) {
                // Payment success callback from Razorpay modal
                markPaymentSuccess(response.razorpay_payment_id, response.razorpay_order_id, response.razorpay_signature);
            },
            "prefill": {
                "name": "@Model.RenterName",
                "email": "@User.Identity?.Name"
            },
            "theme": {
                "color": "#2563eb"
            },
            "modal": {
                "ondismiss": function() {
                    console.log('Razorpay modal dismissed.');
                }
            }
        };

        try {
            const rzp = new Razorpay(options);
            rzp.on('payment.failed', function (response) {
                const desc = response.error ? (response.error.description || response.error.reason) : "Payment declined.";
                document.getElementById('paymentErrorText').innerHTML =
                    `<div class="alert alert-warning border-0 rounded-3 p-3 mt-2 shadow-sm">
                        <div class="fw-semibold text-warning mb-1"><i class="fa-solid fa-triangle-exclamation me-1"></i> Gateway Error: ${desc}</div>
                        <div class="small text-white-50 mb-2">The Razorpay gateway rejected this payment (e.g. test credentials or declined bank). You can complete this transaction using the Dev Simulator.</div>
                        <button type="button" class="btn btn-sm btn-outline-warning rounded-pill px-3" onclick="openRazorpaySimulatorModal()">
                            <i class="fa-solid fa-vial me-1"></i> Complete via Simulator
                        </button>
                    </div>`;
            });
            rzp.open();
        } catch (e) {
            console.warn("Razorpay standard modal popup failed:", e);
            openRazorpaySimulatorModal();
        }
    }

    function openRazorpaySimulatorModal() {
        const modalEl = document.getElementById('razorpaySimulatorModal');
        const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
        modalInstance.show();
    }

    function executeSimulatedRazorpayPayment() {
        const btn = document.getElementById('btnExecuteSimulatedPay');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Authorizing with Razorpay...';

        setTimeout(function() {
            const simulatedPaymentId = "pay_sim_" + Math.random().toString(36).substring(2, 12);
            const currentOrderId = document.getElementById('rzpOrderId').value;
            const orderId = (currentOrderId && !currentOrderId.startsWith('order_test_')) 
                ? currentOrderId 
                : ("order_sim_" + Math.random().toString(36).substring(2, 10));
            const signature = "sig_simulated_" + Math.random().toString(36).substring(2, 14);

            // Close simulator modal
            const modalEl = document.getElementById('razorpaySimulatorModal');
            const modalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modalInstance.hide();

            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-shield-check me-1"></i> Authorize &amp; Pay ₹@Model.AmountToPay.ToString("N0")';

            markPaymentSuccess(simulatedPaymentId, orderId, signature);
        }, 600);
    }

    function simulateTestPayment() {
        openRazorpaySimulatorModal();
    }

    function markPaymentSuccess(paymentId, orderId, signature) {
        document.getElementById('rzpPaymentId').value = paymentId;
        if (orderId) document.getElementById('rzpOrderId').value = orderId;
        if (signature) document.getElementById('rzpSignature').value = signature;

        document.getElementById('confirmedPaymentId').innerText = paymentId;
        document.getElementById('paymentPendingBox').classList.add('d-none');
        document.getElementById('paymentSuccessBox').classList.remove('d-none');
        document.getElementById('paymentErrorText').innerHTML = '';

        const submitBtn = document.getElementById('btnSubmitReturn');
        submitBtn.innerHTML = '<i class="fa-solid fa-check me-1"></i> Submit Asset Return &amp; Comparison Report';
        submitBtn.classList.remove('btn-primary');
        submitBtn.classList.add('btn-success');

        isPaymentDone = true;
    }

    function handleReturnFormSubmit() {
        const form = document.getElementById('returnAssetForm');
        const paymentId = document.getElementById('rzpPaymentId').value;
        const fileInput = document.getElementById('returnFileInput');

        if (!fileInput.files || fileInput.files.length === 0) {
            alert('Please select and upload at least one post-use photo of the asset.');
            fileInput.focus();
            return;
        }

        const amountToPay = parseFloat(document.getElementById('rzpAmountToPay')?.value || '0');
        if (amountToPay > 0 && (!paymentId || !isPaymentDone)) {
            document.getElementById('paymentErrorText').innerText =
                'Payment via Razorpay is required to complete return of this asset. Please click the payment button below.';
            openRazorpayCheckout();
            return;
        }

        form.submit();
    }
</script>
