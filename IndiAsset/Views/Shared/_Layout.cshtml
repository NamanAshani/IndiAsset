<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - IndiAsset</title>

    <!-- Bootstrap 5 + Font Awesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">

    <style>
            * {
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            }

            body {
                background-color: #f8fafc;
                color: #0b2b4a;
            }

            /* ---------- Navbar ---------- */
            .navbar {
                background: rgba(255, 255, 255, 0.9) !important;
                backdrop-filter: blur(10px);
                border-bottom: 1px solid rgba(0, 0, 0, 0.05);
                padding: 1rem 0;
            }

            .navbar-brand {
                font-weight: 700;
                font-size: 1.8rem;
                letter-spacing: -0.5px;
                color: #0b2b4a !important;
            }

            .navbar-brand span {
                color: #2563eb;
            }

            .nav-link {
                font-weight: 500;
                color: #1e293b !important;
                margin: 0 0.5rem;
            }

            .nav-link:hover {
                color: #2563eb !important;
            }

            /* ---------- Buttons (shared) ---------- */
            .btn-primary-custom {
                background-color: #2563eb;
                border: none;
                padding: 0.6rem 1.5rem;
                font-weight: 600;
                border-radius: 40px;
                color: white;
                transition: all 0.2s;
            }

            .btn-primary-custom:hover {
                background-color: #1d4ed8;
                transform: translateY(-1px);
                box-shadow: 0 8px 16px -6px rgba(37, 99, 235, 0.3);
                color: white;
            }

            .btn-outline-custom {
                border: 1.5px solid #2563eb;
                background: transparent;
                color: #2563eb;
                font-weight: 600;
                padding: 0.6rem 1.5rem;
                border-radius: 40px;
                transition: all 0.2s;
            }

            .btn-outline-custom:hover {
                background-color: #eff6ff;
                border-color: #2563eb;
                color: #2563eb;
            }

            /* ---------- Footer ---------- */
            .footer {
                padding: 2.5rem 0;
                color: #64748b;
                border-top: 1px solid #e2e8f0;
            }

            .footer a {
                color: #2563eb;
                text-decoration: none;
                font-weight: 500;
            }

            .footer a:hover {
                text-decoration: underline;
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ========== NAVBAR ========== -->
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="fas fa-cubes me-2" style="color: #2563eb;"></i>
                Indi<span>Asset</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" href="#">Browse Assets</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">List Your Asset</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">How it works</a>
                    </li>
                    <partial name="_LoginPartial" />
                </ul>
            </div>
        </div>
    </nav>

    <!-- ========== PAGE CONTENT ========== -->
    <main>
        @RenderBody()
    </main>

    <!-- ========== FOOTER ========== -->
    <footer class="footer">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <span class="fw-bold" style="color: #0b2b4a;">IndiAsset</span> &copy; @DateTime.Now.Year — Lease big assets, simply.
                </div>
                <div class="col-md-6 text-center text-md-end mt-3 mt-md-0">
                    <a href="#" class="me-3">Privacy</a>
                    <a href="#" class="me-3">Terms</a>
                    <a href="#">Support</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>