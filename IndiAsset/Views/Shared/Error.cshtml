@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="card p-5 rounded-4 border-0 mx-auto text-center" style="max-width: 650px; background: #1a1d27; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
        <div class="d-inline-flex p-3 rounded-circle bg-danger bg-opacity-10 border border-danger border-opacity-25 mx-auto mb-3">
            <i class="fas fa-exclamation-triangle fa-2x text-danger"></i>
        </div>
        <h2 class="fw-bold text-white mb-2">Something Went Wrong</h2>
        <p class="text-muted mb-4">An error occurred while processing your request.</p>

        @if (Model.ShowRequestId)
        {
            <div class="p-3 rounded-3 bg-dark mb-4 text-start font-monospace small text-muted border border-secondary border-opacity-25">
                <span class="text-secondary">Request ID:</span> <span class="text-light">@Model.RequestId</span>
            </div>
        }

        <div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom px-4">
                <i class="fas fa-home me-1"></i> Return Home
            </a>
        </div>
    </div>
</div>
