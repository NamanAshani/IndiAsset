@using Microsoft.AspNetCore.Identity
@using IndiAsset.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="Chat" asp-action="Index">
                <i class="fas fa-comments text-primary me-1"></i> Messages
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" asp-controller="Profile" asp-action="Index">
                <i class="fas fa-user-circle text-primary me-1"></i> Profile
            </a>
        </li>

        <li class="nav-item ms-2">
            <form class="form-inline d-inline"
                  asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit"
                        class="btn btn-sm btn-outline-custom">
                    <i class="fas fa-sign-out-alt me-1"></i> Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link"
               asp-area="Identity"
               asp-page="/Account/Login">
                <i class="fas fa-sign-in-alt me-1"></i> Sign In
            </a>
        </li>

        <li class="nav-item ms-2">
            <a class="btn btn-sm btn-primary-custom"
               asp-area="Identity"
               asp-page="/Account/Register">
                Register
            </a>
        </li>
    }
</ul>