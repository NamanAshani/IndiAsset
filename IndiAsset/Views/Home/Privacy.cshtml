@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="card p-4 p-md-5 rounded-4 shadow-sm border-0" style="background: #1a1d27; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
        <h1 class="fw-bold text-white mb-3"><i class="fas fa-shield-alt text-primary me-2"></i>@ViewData["Title"]</h1>
        <p class="text-muted mb-4">Last updated: October 2026</p>

        <div class="text-light" style="line-height: 1.8;">
            <h4 class="text-white fw-semibold mt-3">1. Information We Collect</h4>
            <p class="text-muted">IndiAsset collects information necessary to facilitate asset leasing and owner-renter communications, including contact details, equipment listings, and communication histories.</p>

            <h4 class="text-white fw-semibold mt-4">2. Real-Time Communications</h4>
            <p class="text-muted">Chat messages exchanged between asset owners and renters are transmitted and stored securely to ensure transparent lease agreements and provide customer support.</p>

            <h4 class="text-white fw-semibold mt-4">3. Data Protection</h4>
            <p class="text-muted">We adhere to modern encryption and security standards to protect your personal information and lease records.</p>
        </div>
    </div>
</div>
