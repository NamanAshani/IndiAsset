@page
@model LoginModel

@{
    ViewData["Title"] = "Sign In";
}

<style>
    .auth-page {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
        background: #0f1117;
    }

    .auth-card {
        width: 100%;
        max-width: 460px;
        background: #1a1d27;
        border-radius: 20px;
        padding: 42px;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .auth-logo {
        width: 60px;
        height: 60px;
        background: rgba(37, 99, 235, 0.15);
        border: 1px solid rgba(59, 130, 246, 0.3);
        color: #60a5fa;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 800;
        margin: 0 auto 20px;
    }

    .auth-heading {
        text-align: center;
        font-size: 28px;
        font-weight: 700;
        color: #f8fafc;
        margin-bottom: 8px;
    }

    .auth-subtitle {
        text-align: center;
        color: #94a3b8;
        font-size: 14px;
        margin-bottom: 30px;
    }

    .auth-label {
        font-size: 14px;
        font-weight: 600;
        color: #cbd5e1;
        margin-bottom: 8px;
    }

    .auth-input {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        font-size: 14px;
        background: #1e2130;
        color: #f1f5f9;
        transition: all 0.2s;
    }

    .auth-input:focus {
        outline: none;
        border-color: #3b82f6;
        background: #252838;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
        color: #ffffff;
    }

    .auth-btn {
        width: 100%;
        padding: 13px;
        border: none;
        border-radius: 10px;
        background: #2563eb;
        color: white;
        font-size: 16px;
        font-weight: 650;
        margin-top: 18px;
        transition: 0.2s;
        box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3);
    }

    .auth-btn:hover {
        background: #3b82f6;
        transform: translateY(-1px);
        color: white;
    }

    .auth-link {
        color: #60a5fa;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
    }

    .auth-link:hover {
        text-decoration: underline;
        color: #93c5fd;
    }

    .auth-footer {
        text-align: center;
        color: #94a3b8;
        font-size: 14px;
        margin-top: 25px;
    }

    .field-error {
        color: #f87171;
        font-size: 13px;
    }

    @@media (max-width: 576px) {
        .auth-card {
            padding: 30px 22px;
        }
    }
</style>

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-logo">
            <i class="fas fa-cubes"></i>
        </div>

        <h1 class="auth-heading">Welcome back</h1>
        <p class="auth-subtitle">
            Sign in to manage your assets and lease bookings.
        </p>

        <form id="account" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="field-error mb-3" role="alert">
            </div>

            <div class="mb-4">
                <label asp-for="Input.Email"
                       class="auth-label">Email Address</label>

                <input asp-for="Input.Email"
                       class="auth-input"
                       autocomplete="username"
                       placeholder="you@example.com" />

                <span asp-validation-for="Input.Email"
                      class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password"
                       class="auth-label">Password</label>

                <div class="position-relative">
                    <input asp-for="Input.Password"
                           type="password"
                           id="loginPassword"
                           class="auth-input pe-5"
                           autocomplete="current-password"
                           placeholder="Enter your password" />
                    <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted text-decoration-none pe-3 border-0 bg-transparent" onclick="togglePasswordVisibility('loginPassword', this)" tabindex="-1" title="Toggle password visibility">
                        <i class="far fa-eye"></i>
                    </button>
                </div>

                <span asp-validation-for="Input.Password"
                      class="field-error"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">

                <div class="form-check">
                    <input asp-for="Input.RememberMe"
                           class="form-check-input" />

                    <label asp-for="Input.RememberMe"
                           class="form-check-label"
                           style="font-size:14px;color:#94a3b8">
                        Remember me
                    </label>
                </div>

                <a asp-page="./ForgotPassword"
                   class="auth-link">
                    Forgot password?
                </a>

            </div>

            <button id="login-submit"
                    type="submit"
                    class="auth-btn">
                Sign In
            </button>

        </form>

        <div class="auth-footer">
            Don't have an account?
            <a asp-page="./Register"
               class="auth-link">
                Create account
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePasswordVisibility(inputId, btn) {
            var input = document.getElementById(inputId);
            var icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
}