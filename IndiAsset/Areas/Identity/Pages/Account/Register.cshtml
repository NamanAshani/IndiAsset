@page
@model RegisterModel

@{
    ViewData["Title"] = "Create Account";
}

<style>
    .auth-page {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
        background: #0f1117;
    }

    .auth-card {
        width: 100%;
        max-width: 540px;
        background: #1a1d27;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .auth-logo {
        width: 58px;
        height: 58px;
        background: rgba(37, 99, 235, 0.15);
        border: 1px solid rgba(59, 130, 246, 0.3);
        color: #60a5fa;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        font-weight: 800;
        margin: 0 auto 18px;
    }

    .auth-heading {
        text-align: center;
        font-size: 28px;
        font-weight: 700;
        color: #f8fafc;
        margin-bottom: 8px;
    }

    .auth-subtitle {
        text-align: center;
        color: #94a3b8;
        margin-bottom: 28px;
        font-size: 14px;
    }

    .auth-label {
        font-weight: 600;
        font-size: 14px;
        color: #cbd5e1;
        margin-bottom: 7px;
    }

    .auth-input {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        font-size: 14px;
        background: #1e2130;
        color: #f1f5f9;
        transition: all 0.2s;
    }

    .auth-input:focus {
        outline: none;
        border-color: #3b82f6;
        background: #252838;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
        color: #ffffff;
    }

    .auth-btn {
        width: 100%;
        padding: 13px;
        border: none;
        border-radius: 10px;
        background: #2563eb;
        color: white;
        font-weight: 650;
        font-size: 16px;
        margin-top: 10px;
        transition: 0.2s;
        box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3);
    }

    .auth-btn:hover {
        background: #3b82f6;
        transform: translateY(-1px);
        color: white;
    }

    .auth-footer {
        text-align: center;
        margin-top: 24px;
        color: #94a3b8;
        font-size: 14px;
    }

    .auth-footer a {
        color: #60a5fa;
        font-weight: 650;
        text-decoration: none;
    }

    .auth-footer a:hover {
        text-decoration: underline;
        color: #93c5fd;
    }

    .field-error {
        font-size: 13px;
        color: #f87171;
    }

    @@media (max-width: 576px) {
        .auth-card {
            padding: 28px 22px;
        }
    }
</style>

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-logo">
            <i class="fas fa-cubes"></i>
        </div>

        <h1 class="auth-heading">Create your account</h1>
        <p class="auth-subtitle">
            Join IndiAsset to lease equipment or list your own assets.
        </p>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="field-error mb-3" role="alert">
            </div>

            <div class="mb-3">
                <label asp-for="Input.FullName"
                       class="auth-label">Full Name</label>
                <input asp-for="Input.FullName"
                       class="auth-input"
                       placeholder="Enter your full name" />
                <span asp-validation-for="Input.FullName"
                      class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email"
                       class="auth-label">Email Address</label>
                <input asp-for="Input.Email"
                       class="auth-input"
                       autocomplete="username"
                       placeholder="you@example.com" />
                <span asp-validation-for="Input.Email"
                      class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.PhoneNumber"
                       class="auth-label">Phone Number</label>
                <input asp-for="Input.PhoneNumber"
                       class="auth-input"
                       placeholder="Enter your phone number" />
                <span asp-validation-for="Input.PhoneNumber"
                      class="field-error"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.City"
                           class="auth-label">City</label>
                    <input asp-for="Input.City"
                           class="auth-input"
                           placeholder="Your city" />
                    <span asp-validation-for="Input.City"
                          class="field-error"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Input.Address"
                           class="auth-label">Address</label>
                    <input asp-for="Input.Address"
                           class="auth-input"
                           placeholder="Your address" />
                    <span asp-validation-for="Input.Address"
                          class="field-error"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password"
                       class="auth-label">Password</label>
                <div class="position-relative">
                    <input asp-for="Input.Password"
                           type="password"
                           id="regPassword"
                           class="auth-input pe-5"
                           autocomplete="new-password"
                           placeholder="Create a password" />
                    <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted text-decoration-none pe-3 border-0 bg-transparent" onclick="togglePasswordVisibility('regPassword', this)" tabindex="-1" title="Toggle password visibility">
                        <i class="far fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.Password"
                      class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword"
                       class="auth-label">Confirm Password</label>
                <div class="position-relative">
                    <input asp-for="Input.ConfirmPassword"
                           type="password"
                           id="regConfirmPassword"
                           class="auth-input pe-5"
                           autocomplete="new-password"
                           placeholder="Re-enter your password" />
                    <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted text-decoration-none pe-3 border-0 bg-transparent" onclick="togglePasswordVisibility('regConfirmPassword', this)" tabindex="-1" title="Toggle password visibility">
                        <i class="far fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword"
                      class="field-error"></span>
            </div>

            <button id="registerSubmit"
                    type="submit"
                    class="auth-btn">
                Create Account
            </button>

        </form>

        <div class="auth-footer">
            Already have an account?
            <a asp-page="./Login"
               asp-route-returnUrl="@Model.ReturnUrl">
                Sign in
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePasswordVisibility(inputId, btn) {
            var input = document.getElementById(inputId);
            var icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
}