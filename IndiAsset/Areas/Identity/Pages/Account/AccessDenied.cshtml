@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="card p-5 rounded-4 border-0 mx-auto text-center" style="max-width: 540px; background: #1a1d27; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
        <div class="d-inline-flex p-3 rounded-circle bg-danger bg-opacity-10 border border-danger border-opacity-25 mx-auto mb-3">
            <i class="fas fa-shield-alt fa-2x text-danger"></i>
        </div>
        <h2 class="fw-bold text-white mb-2">Access Denied</h2>
        <p class="text-muted mb-4">You do not have permission to access this resource or perform this action.</p>
        <div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom px-4">
                <i class="fas fa-home me-1"></i> Return Home
            </a>
        </div>
    </div>
</div>
