@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="card p-4 p-md-5 rounded-4 shadow-sm border-0" style="background: #1a1d27;">
        <div class="border-bottom border-secondary border-opacity-25 pb-3 mb-4">
            <h2 class="fw-bold text-white mb-1"><i class="fas fa-user-cog text-primary me-2"></i>Account Management</h2>
            <p class="text-muted mb-0">Manage your profile information, password, and security preferences.</p>
        </div>
        <div class="row g-4">
            <div class="col-lg-3">
                <partial name="_ManageNav" />
            </div>
            <div class="col-lg-9 ps-lg-4">
                @RenderBody()
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
